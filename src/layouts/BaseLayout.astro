---
import '@fontsource/barlow-condensed/700.css';
import '@fontsource/barlow-condensed/800.css';
import '@fontsource/barlow-condensed/900.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import NewsletterGate from '../components/NewsletterGate.astro';
import { ClientRouter } from 'astro:transitions';
import { withBase } from '../lib/base';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  page?: string;
  mainClass?: string;
}

const {
  title = 'LIFESTEAL',
  description = 'Independent record label and alternative lifestyle brand based in Naarm.',
  image = '/assets/releases/audioclub-cover.jpg',
  page = 'default',
  mainClass = '',
} = Astro.props;

const pageTitle = title === 'LIFESTEAL' ? 'lifesteal' : `${title} // lifesteal`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(withBase(image), Astro.site);
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href={withBase('/assets/brand/icon.svg')} type="image/svg+xml" />
    <link rel="manifest" href={withBase('/site.webmanifest')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="LIFESTEAL" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script is:inline>
      try {
        const accent = localStorage.getItem('lifesteal.accent');
        const logoBackground = localStorage.getItem('lifesteal.logoBackground');
        const themeName = localStorage.getItem('lifesteal.themeName') || 'green';
        if (/^[a-z0-9-]+$/i.test(themeName)) {
          document.documentElement.dataset.theme = themeName;
        }
        if (accent && /^#[\da-f]{6}$/i.test(accent)) {
          document.documentElement.style.setProperty('--accent', accent);
        }
        if (logoBackground && /^(?:linear|radial)-gradient\(/i.test(logoBackground)) {
          document.documentElement.style.setProperty('--site-logo-background', logoBackground);
        }
      } catch {
        // The green fallback remains in place when storage is unavailable.
      }
      if (window.matchMedia('(max-width: 900px)').matches && document.startViewTransition) {
        try {
          Object.defineProperty(document, 'startViewTransition', {
            value: undefined,
            configurable: true,
          });
        } catch {
          // Astro's animated fallback remains available when the native API cannot be overridden.
        }
      }
    </script>
    <ClientRouter fallback="animate" />
    <title>{pageTitle}</title>
  </head>
  <body data-page={page}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="screen-texture" aria-hidden="true"></div>
    <Header transition:persist="site-header" />
    <main id="main-content" class:list={['site-main', mainClass]}>
      <slot />
    </main>
    <Footer transition:persist="site-footer" />
    <NewsletterGate transition:persist="newsletter-gate" />
    <script>
      const setupTypingFill = () => {
        const candidates = document.querySelectorAll<HTMLElement>(
          '.site-main :is(p, dd, dt, li, small, .eyebrow):not(.visually-hidden)',
        );
        const reveal = (element: HTMLElement, index: number) => {
          element.style.setProperty('--type-fill-delay', `${Math.min(index * 18, 240)}ms`);
          requestAnimationFrame(() => element.classList.add('body-type-fill'));
        };
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const element = entry.target as HTMLElement;
              reveal(element, Number(element.dataset.typeFillIndex ?? 0));
              observer.unobserve(element);
            });
          },
          { threshold: 0.08 },
        );
        candidates.forEach((element, index) => {
          if (element.closest('pre, ascii-title, [data-ascii-stage]')) return;
          element.classList.remove('body-type-fill');
          element.dataset.typeFillIndex = String(index);
          observer.observe(element);
        });
        document.addEventListener('astro:before-swap', () => observer.disconnect(), { once: true });
      };
      const syncPrismAnimations = () => {
        requestAnimationFrame(() => {
          document.getAnimations().forEach((animation) => {
            if (typeof CSSAnimation === 'undefined' || !(animation instanceof CSSAnimation)) return;
            if (
              !animation.animationName.includes('prism') ||
              animation.animationName === 'header-prism'
            ) {
              return;
            }
            try {
              animation.startTime = 0;
            } catch {
              // An animation can disappear during an Astro page swap; the next page-load resyncs it.
            }
          });
        });
      };
      document.addEventListener('astro:page-load', setupTypingFill);
      document.addEventListener('astro:page-load', syncPrismAnimations);
      window.addEventListener('lifesteal:prism-ready', syncPrismAnimations);
    </script>
  </body>
</html>

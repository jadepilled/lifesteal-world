---
import AsciiTitle from '../components/AsciiTitle.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/base';

const stationEnabled = import.meta.env.PUBLIC_RADIO_ENABLED !== 'false';
const hlsUrl = import.meta.env.PUBLIC_RADIO_HLS_URL ?? '';
const mp3Url =
  import.meta.env.PUBLIC_RADIO_MP3_URL ??
  'https://lifesteal-signal-api.jade-431.workers.dev/radio/stream.mp3';
const metadataUrl =
  import.meta.env.PUBLIC_RADIO_METADATA_URL ??
  'https://lifesteal-signal-api.jade-431.workers.dev/radio/now-playing.json';
const offlineArtwork = '/assets/radio/offline-placeholder.svg';
---

<BaseLayout
  title="Radio"
  description="The LIFESTEAL live radio signal. One continuous programme shared by every listener."
  image={offlineArtwork}
  page="radio"
>
  <section
    class:list={['radio-console', 'panel', { 'radio-console--offline': !stationEnabled }]}
    data-radio-console
    data-enabled={stationEnabled ? 'true' : 'false'}
    data-hls-url={hlsUrl}
    data-mp3-url={mp3Url}
    data-metadata-url={metadataUrl}
    data-state="offline"
    data-visualizer-mode="visualizer"
    aria-label="LIFESTEAL radio player"
  >
    <div class="radio-console__art-shell">
      <canvas class="radio-console__visualizer" data-radio-visualizer aria-hidden="true"></canvas>
      <div class="radio-console__artwork-display" data-radio-display-artwork aria-hidden="true">
        <img
          src={withBase(offlineArtwork)}
          alt=""
          width="1080"
          height="1080"
          data-radio-display-artwork-image
        />
        <span data-radio-artwork-label>NO MEDIA LOADED</span>
      </div>
      <button
        class="radio-console__visualizer-toggle accent-prism-frame"
        type="button"
        data-radio-visualizer-toggle
        aria-pressed="true"
      >
        VISUALIZER / ON
      </button>
      <dl class="radio-console__telemetry" aria-label="Broadcast connection statistics">
        <div><dt>PING</dt><dd data-radio-ping>— MS</dd></div>
        <div><dt>DOWN</dt><dd data-radio-downlink>CHECKING</dd></div>
        <div><dt>BUFFER</dt><dd data-radio-buffer>STANDBY</dd></div>
      </dl>
      <div class="radio-console__signal" aria-hidden="true">
        {
          Array.from({ length: 22 }, (_, index) => (
            <span style={`--bar:${index};--height:${12 + (index % 8) * 10}%`} />
          ))
        }
      </div>
    </div>

    <div class="radio-console__readout">
      <div class="radio-console__topline">
        <span class="live-dot" aria-hidden="true"></span>
        <span data-radio-state>{stationEnabled ? 'READY TO JOIN' : 'SIGNAL OFFLINE'}</span>
        <span>CH.001</span>
      </div>

      <div class="radio-console__metadata">
        <div class="radio-console__info-artwork" data-radio-info-artwork>
          <img
            src={withBase(offlineArtwork)}
            alt="LIFESTEAL broadcast offline placeholder"
            width="1080"
            height="1080"
            data-radio-info-artwork-image
          />
        </div>
        <div class="radio-console__metadata-copy">
          <p class="radio-console__artist" data-radio-artist>NO MEDIA LOADED</p>
          <AsciiTitle
            text="STREAM OFFLINE"
            variants={['STREAM OFFLINE']}
            accent="var(--radio-title-accent, #ff304f)"
            id="radio-now-playing"
          />
          <p class="radio-console__album" data-radio-album>CHANNEL IDLE</p>
        </div>
      </div>

      <div class="radio-console__divider" aria-hidden="true">
        <span></span><span></span><span></span>
      </div>

      <div class="radio-console__controls">
        <button
          class="radio-console__join"
          type="button"
          data-radio-toggle
          disabled={!stationEnabled}
        >
          {stationEnabled ? 'JOIN LIVE SIGNAL' : 'BROADCAST NOT AVAILABLE'}
        </button>
        <label class="radio-console__volume">
          <span>LEVEL</span>
          <input
            data-radio-volume
            type="range"
            min="0"
            max="1"
            step="0.05"
            value="0.8"
            disabled={!stationEnabled}
          />
        </label>
      </div>

      <audio data-radio-audio preload="none" crossorigin="anonymous"></audio>
    </div>
  </section>
</BaseLayout>

<script>
  type NowPlaying = {
    status?: 'online' | 'offline';
    id?: string;
    artist?: string;
    title?: string;
    titleAscii?: string;
    album?: string;
    year?: number;
    label?: string;
    artwork?: string;
    palette?: string[];
    broadcast?: {
      bitrateKbps?: number;
      channels?: number;
      codec?: string;
      sampleRate?: number;
    };
  };

  const setupRadio = () => {
    const consoleElement = document.querySelector<HTMLElement>('[data-radio-console]');
    if (!consoleElement) return;
    const revealUI = () =>
      requestAnimationFrame(() => {
        consoleElement.dataset.uiReady = 'true';
      });
    if (consoleElement.dataset.enabled !== 'true') {
      revealUI();
      return;
    }
    const audio = consoleElement.querySelector<HTMLAudioElement>('[data-radio-audio]');
    const toggle = consoleElement.querySelector<HTMLButtonElement>('[data-radio-toggle]');
    const volume = consoleElement.querySelector<HTMLInputElement>('[data-radio-volume]');
    const state = consoleElement.querySelector<HTMLElement>('[data-radio-state]');
    const artist = consoleElement.querySelector<HTMLElement>('[data-radio-artist]');
    const album = consoleElement.querySelector<HTMLElement>('[data-radio-album]');
    const displayArtwork = consoleElement.querySelector<HTMLImageElement>(
      '[data-radio-display-artwork-image]',
    );
    const infoArtwork = consoleElement.querySelector<HTMLImageElement>(
      '[data-radio-info-artwork-image]',
    );
    const artworkLabel = consoleElement.querySelector<HTMLElement>('[data-radio-artwork-label]');
    const visualizerCanvas =
      consoleElement.querySelector<HTMLCanvasElement>('[data-radio-visualizer]');
    const visualizerToggle = consoleElement.querySelector<HTMLButtonElement>(
      '[data-radio-visualizer-toggle]',
    );
    const ping = consoleElement.querySelector<HTMLElement>('[data-radio-ping]');
    const downlink = consoleElement.querySelector<HTMLElement>('[data-radio-downlink]');
    const buffer = consoleElement.querySelector<HTMLElement>('[data-radio-buffer]');
    let hls: { destroy: () => void } | undefined;
    let visualizer:
      | {
          connectAudio: () => Promise<void>;
          destroy: () => void;
          setActive: (active: boolean) => void;
          setPalette: (colors: string[]) => void;
        }
      | undefined;
    let metadataTimer = 0;
    let visualizerTimer = 0;
    let telemetryTimer = 0;
    let loading = false;
    let activeTrackKey = '';
    let visualizerEnabled = window.matchMedia('(min-width: 901px)').matches;
    let latestPalette = ['#ff304f', '#9127ff', '#f2a6ff'];
    const localArtworkById: Record<string, string> = {
      'hazelmere-life-is-beautiful': `${import.meta.env.BASE_URL}assets/radio/life-is-beautiful.webp`,
    };

    const readableAccent = (colors: string[]) => {
      const parsed = colors
        .map((color) => /^#([0-9a-f]{6})$/iu.exec(color)?.[1])
        .filter((color): color is string => Boolean(color))
        .map((color) =>
          [0, 2, 4].map((offset) => Number.parseInt(color.slice(offset, offset + 2), 16)),
        );
      if (!parsed.length) return '#f2a6ff';
      const luminance = ([red, green, blue]: number[]) =>
        red! * 0.2126 + green! * 0.7152 + blue! * 0.0722;
      const selected = parsed.sort((left, right) => luminance(right) - luminance(left))[0]!;
      const current = luminance(selected);
      const mix = current < 164 ? Math.min(0.58, (164 - current) / (255 - current)) : 0;
      const lifted = selected.map((channel) => Math.round(channel! + (255 - channel!) * mix));
      return `#${lifted.map((channel) => channel.toString(16).padStart(2, '0')).join('')}`;
    };

    const updateConnectionStats = () => {
      const connection = (
        navigator as Navigator & {
          connection?: { downlink?: number; effectiveType?: string; rtt?: number };
        }
      ).connection;
      if (downlink) {
        downlink.textContent = connection?.downlink
          ? `${connection.downlink.toFixed(1)} MBPS`
          : navigator.onLine
            ? 'ONLINE'
            : 'OFFLINE';
      }
      if (ping && connection?.rtt && ping.textContent === '— MS') {
        ping.textContent = `${Math.round(connection.rtt)} MS`;
      }
    };

    const updateBufferDepth = () => {
      if (!buffer || !audio) return;
      if (audio.paused) {
        buffer.textContent = consoleElement.dataset.state === 'ready' ? 'READY' : 'STANDBY';
        return;
      }
      if (!audio.buffered.length || !Number.isFinite(audio.currentTime)) {
        buffer.textContent = 'LIVE';
        return;
      }
      const seconds = Math.max(
        0,
        audio.buffered.end(audio.buffered.length - 1) - audio.currentTime,
      );
      buffer.textContent = `${seconds.toFixed(1)} S`;
    };

    const ensureVisualizer = async () => {
      if (
        visualizer ||
        !visualizerCanvas ||
        !audio ||
        window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
        !window.matchMedia('(min-width: 901px)').matches
      )
        return visualizer;
      const { createRadioVisualizer } = await import('../lib/radio-visualizer');
      visualizer = createRadioVisualizer(visualizerCanvas, audio);
      visualizer?.setPalette(latestPalette);
      visualizer?.setActive(visualizerEnabled);
      return visualizer;
    };

    const setVisualizerMode = async (enabled: boolean) => {
      visualizerEnabled = enabled && window.matchMedia('(min-width: 901px)').matches;
      consoleElement.dataset.visualizerMode = visualizerEnabled ? 'visualizer' : 'artwork';
      if (visualizerToggle) {
        visualizerToggle.setAttribute('aria-pressed', String(visualizerEnabled));
        visualizerToggle.textContent = visualizerEnabled ? 'VISUALIZER / ON' : 'VISUALIZER / OFF';
      }
      if (visualizerEnabled) {
        const instance = await ensureVisualizer();
        instance?.setActive(true);
      } else {
        visualizer?.setActive(false);
      }
    };

    const setState = (value: string, machineState: string) => {
      if (state) state.textContent = value;
      consoleElement.dataset.state = machineState;
    };

    const useMp3Fallback = () => {
      if (!audio || !consoleElement.dataset.mp3Url) return;
      hls?.destroy();
      hls = undefined;
      audio.src = consoleElement.dataset.mp3Url;
    };

    const attachStream = async () => {
      if (!audio || loading) return;
      loading = true;
      audio.crossOrigin = 'anonymous';
      const hlsUrl = consoleElement.dataset.hlsUrl;
      try {
        if (visualizerEnabled) await ensureVisualizer();
        if (hlsUrl && audio.canPlayType('application/vnd.apple.mpegurl')) {
          audio.src = hlsUrl;
        } else if (hlsUrl) {
          const { default: Hls } = await import('hls.js');
          if (!Hls.isSupported()) {
            useMp3Fallback();
          } else {
            const instance = new Hls({
              liveSyncDurationCount: 3,
              liveMaxLatencyDurationCount: 8,
              enableWorker: true,
            });
            instance.on(Hls.Events.ERROR, (_event, data) => {
              if (data.fatal) useMp3Fallback();
            });
            instance.loadSource(hlsUrl);
            instance.attachMedia(audio);
            hls = instance;
          }
        } else {
          useMp3Fallback();
        }
        if (visualizerEnabled) await visualizer?.connectAudio();
        await audio.play();
        setState('LIVE / CONNECTED', 'playing');
        if (toggle) toggle.textContent = 'LEAVE LIVE SIGNAL';
      } catch {
        setState('CONNECTION FAILED', 'error');
      } finally {
        loading = false;
      }
    };

    const stopStream = () => {
      if (!audio) return;
      audio.pause();
      audio.removeAttribute('src');
      audio.load();
      hls?.destroy();
      hls = undefined;
      setState('READY TO JOIN', 'ready');
      if (toggle) toggle.textContent = 'JOIN LIVE SIGNAL';
    };

    const refreshMetadata = async () => {
      const url = consoleElement.dataset.metadataUrl;
      if (!url) {
        revealUI();
        return;
      }
      const requestStarted = performance.now();
      try {
        const response = await fetch(url, { cache: 'no-store' });
        if (!response.ok) throw new Error('Metadata unavailable');
        const metadata = (await response.json()) as NowPlaying;
        if (ping)
          ping.textContent = `${Math.max(1, Math.round(performance.now() - requestStarted))} MS`;
        if (metadata.status === 'offline') throw new Error('Broadcast offline');
        const nextTrackKey = metadata.id ?? `${metadata.artist ?? ''}:${metadata.title ?? ''}`;
        const trackChanged = nextTrackKey !== activeTrackKey;
        const artworkUrl =
          (metadata.id ? localArtworkById[metadata.id] : undefined) ??
          (metadata.artwork
            ? new URL(
                metadata.artwork.startsWith('/') ? `/radio${metadata.artwork}` : metadata.artwork,
                url,
              ).toString()
            : undefined);

        if (trackChanged && artworkUrl) {
          const pendingArtwork = new Image();
          pendingArtwork.src = artworkUrl;
          await Promise.race([
            pendingArtwork.decode().catch(() => undefined),
            new Promise((resolve) => window.setTimeout(resolve, 900)),
          ]);
        }
        if (activeTrackKey && trackChanged) {
          consoleElement.classList.add('radio-console--track-changing');
          await new Promise((resolve) => window.setTimeout(resolve, 170));
        }

        consoleElement.classList.remove('radio-console--offline');
        if (consoleElement.dataset.state === 'offline') setState('READY TO JOIN', 'ready');
        if (trackChanged && metadata.title) {
          window.dispatchEvent(
            new CustomEvent('lifesteal:ascii-title', {
              detail: {
                id: 'radio-now-playing',
                text: metadata.title,
                ascii: metadata.titleAscii,
              },
            }),
          );
        }
        if (artist && metadata.artist) artist.textContent = metadata.artist;
        if (album) {
          album.textContent = [metadata.album, metadata.year, metadata.label]
            .filter(Boolean)
            .join(' / ');
        }
        if (displayArtwork && artworkUrl) {
          displayArtwork.src = artworkUrl;
        }
        if (infoArtwork && artworkUrl) {
          infoArtwork.src = artworkUrl;
          infoArtwork.alt = `${metadata.artist ?? 'LIFESTEAL'} — ${metadata.title ?? 'now playing'} artwork`;
        }
        if (artworkLabel) artworkLabel.textContent = metadata.title ?? 'LIVE SIGNAL';
        if (metadata.palette?.length) {
          consoleElement.style.setProperty(
            '--radio-title-accent',
            readableAccent(metadata.palette),
          );
          latestPalette = metadata.palette;
          if (visualizerEnabled) (await ensureVisualizer())?.setPalette(metadata.palette);
          else visualizer?.setPalette(metadata.palette);
        }
        if ('mediaSession' in navigator && metadata.title) {
          navigator.mediaSession.metadata = new MediaMetadata({
            title: metadata.title,
            artist: metadata.artist,
            album: metadata.album,
            artwork: artworkUrl ? [{ src: artworkUrl }] : [],
          });
        }
        activeTrackKey = nextTrackKey;
        requestAnimationFrame(() =>
          requestAnimationFrame(() =>
            consoleElement.classList.remove('radio-console--track-changing'),
          ),
        );
        revealUI();
      } catch {
        consoleElement.classList.remove('radio-console--track-changing');
        if (audio?.paused) {
          consoleElement.classList.add('radio-console--offline');
          setState('SIGNAL OFFLINE', 'offline');
        }
        revealUI();
      }
    };

    toggle?.addEventListener('click', () => {
      if (audio?.paused) attachStream();
      else stopStream();
    });
    visualizerToggle?.addEventListener('click', () => {
      void setVisualizerMode(!visualizerEnabled);
    });
    volume?.addEventListener('input', () => {
      if (audio) audio.volume = Number(volume.value);
    });
    if (audio && volume) audio.volume = Number(volume.value);
    updateConnectionStats();
    updateBufferDepth();
    window.addEventListener('online', updateConnectionStats);
    window.addEventListener('offline', updateConnectionStats);
    const connection = (navigator as Navigator & { connection?: EventTarget }).connection;
    connection?.addEventListener('change', updateConnectionStats);
    visualizerTimer = window.setTimeout(() => {
      if (visualizerEnabled) void ensureVisualizer();
    }, 750);
    refreshMetadata();
    metadataTimer = window.setInterval(refreshMetadata, 10_000);
    telemetryTimer = window.setInterval(updateBufferDepth, 1_000);
    document.addEventListener(
      'astro:before-swap',
      () => {
        window.clearInterval(metadataTimer);
        window.clearInterval(telemetryTimer);
        window.clearTimeout(visualizerTimer);
        hls?.destroy();
        visualizer?.destroy();
        window.removeEventListener('online', updateConnectionStats);
        window.removeEventListener('offline', updateConnectionStats);
        connection?.removeEventListener('change', updateConnectionStats);
      },
      { once: true },
    );
  };

  document.addEventListener('astro:page-load', setupRadio);
</script>

<style>
  .radio-console {
    display: grid;
    min-height: 0;
    grid-template-columns: minmax(320px, 0.88fr) minmax(400px, 1.12fr);
    overflow: hidden;
    flex: 1;
  }

  .radio-console__art-shell,
  .radio-console__readout > * {
    opacity: 0;
    transform: translateY(10px);
  }

  .radio-console[data-ui-ready='true'] .radio-console__art-shell {
    animation: radio-surface-reveal 680ms cubic-bezier(0.2, 0.72, 0.22, 1) both;
  }

  .radio-console[data-ui-ready='true'] .radio-console__readout > * {
    animation: radio-detail-reveal 520ms cubic-bezier(0.2, 0.72, 0.22, 1) both;
  }

  .radio-console[data-ui-ready='true'] .radio-console__readout > :nth-child(2) {
    animation-delay: 90ms;
  }

  .radio-console[data-ui-ready='true'] .radio-console__readout > :nth-child(3) {
    animation-delay: 150ms;
  }

  .radio-console[data-ui-ready='true'] .radio-console__readout > :nth-child(4) {
    animation-delay: 210ms;
  }

  .radio-console__art-shell {
    position: relative;
    min-height: 0;
    overflow: hidden;
    border-right: 1px solid var(--line);
    background: #020203;
  }

  .radio-console__visualizer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 1;
    filter: blur(0);
    transition:
      opacity 520ms cubic-bezier(0.2, 0.72, 0.22, 1),
      filter 620ms cubic-bezier(0.2, 0.72, 0.22, 1);
  }

  .radio-console__artwork-display {
    position: absolute;
    inset: 0;
    background: #030303;
    opacity: 0;
    filter: blur(12px);
    pointer-events: none;
    transform: scale(1.025);
    transition:
      opacity 520ms cubic-bezier(0.2, 0.72, 0.22, 1),
      filter 620ms cubic-bezier(0.2, 0.72, 0.22, 1),
      transform 720ms cubic-bezier(0.2, 0.72, 0.22, 1);
  }

  .radio-console__artwork-display img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.35) brightness(0.72);
    transition:
      opacity 180ms ease,
      filter 260ms ease,
      transform 380ms cubic-bezier(0.2, 0.72, 0.22, 1);
  }

  .radio-console__artwork-display span {
    position: absolute;
    right: 18px;
    bottom: 18px;
    left: 18px;
    display: block;
    overflow: hidden;
    padding: 8px 10px;
    background: rgba(0, 0, 0, 0.72);
    color: var(--muted);
    font-size: 8px;
    letter-spacing: 0.08em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .radio-console:not(.radio-console--offline) .radio-console__artwork-display img,
  .radio-console:not(.radio-console--offline) .radio-console__info-artwork img {
    filter: none;
  }

  .radio-console[data-visualizer-mode='artwork'] .radio-console__visualizer {
    opacity: 0;
    filter: blur(12px);
  }

  .radio-console[data-visualizer-mode='artwork'] .radio-console__artwork-display {
    opacity: 1;
    filter: blur(0);
    transform: scale(1);
  }

  .radio-console__visualizer-toggle {
    position: absolute;
    z-index: 4;
    right: clamp(18px, 3vw, 38px);
    bottom: 104px;
    min-height: 34px;
    padding: 7px 10px;
    border: 1px solid rgba(244, 241, 234, 0.42);
    background: rgba(0, 0, 0, 0.68);
    color: var(--white);
    font: 600 8px/1 var(--mono);
    letter-spacing: 0.08em;
    cursor: pointer;
    backdrop-filter: blur(8px);
  }

  .radio-console__telemetry {
    position: absolute;
    top: clamp(18px, 3vw, 38px);
    right: clamp(18px, 3vw, 38px);
    display: grid;
    width: min(210px, 42%);
    margin: 0;
    border-top: 1px solid rgba(244, 241, 234, 0.32);
    background: rgba(0, 0, 0, 0.56);
    backdrop-filter: blur(8px);
  }

  .radio-console__telemetry div {
    display: grid;
    grid-template-columns: auto 1fr;
    padding: 7px 0;
    border-bottom: 1px solid rgba(244, 241, 234, 0.16);
    gap: 12px;
  }

  .radio-console__telemetry dt,
  .radio-console__telemetry dd {
    margin: 0;
    font-size: 8px;
    letter-spacing: 0.08em;
  }

  .radio-console__telemetry dt {
    color: var(--muted);
  }

  .radio-console__telemetry dd {
    overflow: hidden;
    color: var(--white);
    text-align: right;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .radio-console__signal {
    position: absolute;
    right: 18px;
    bottom: 18px;
    left: 18px;
    display: flex;
    align-items: flex-end;
    height: 70px;
    gap: 5px;
  }

  .radio-console__signal span {
    width: 100%;
    height: var(--height);
    background: rgba(244, 241, 234, 0.25);
    transform-origin: bottom;
  }

  .radio-console[data-state='playing'] .radio-console__signal span {
    background: var(--magenta);
    box-shadow: 0 0 8px rgba(242, 166, 255, 0.65);
    animation: meter calc(420ms + var(--bar) * 19ms) ease-in-out infinite alternate;
  }

  .radio-console__readout {
    display: flex;
    min-width: 0;
    padding: clamp(22px, 3.8vh, 48px) clamp(28px, 4.2vw, 64px);
    flex-direction: column;
    justify-content: center;
  }

  .radio-console__topline {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    padding-bottom: 13px;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: 9px;
    letter-spacing: 0.1em;
    gap: 10px;
  }

  .live-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--red);
  }

  .radio-console[data-state='playing'] .live-dot {
    box-shadow: 0 0 12px var(--red);
    animation: pulse 1.1s steps(2, end) infinite;
  }

  .radio-console__metadata {
    display: grid;
    grid-template-columns: clamp(96px, 20%, 150px) minmax(0, 1fr);
    align-items: center;
    padding: clamp(20px, 3.4vh, 42px) 0 clamp(15px, 2.3vh, 28px);
    gap: clamp(18px, 2.5vw, 32px);
  }

  .radio-console__info-artwork {
    overflow: hidden;
    border: 1px solid
      color-mix(in srgb, var(--radio-title-accent, var(--line-strong)), transparent 38%);
    aspect-ratio: 1;
    opacity: 1;
    filter: blur(0);
    transform: scale(1);
    transition:
      opacity 420ms ease,
      filter 520ms ease,
      transform 620ms cubic-bezier(0.2, 0.72, 0.22, 1);
  }

  .radio-console__info-artwork img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.35) brightness(0.72);
    transition:
      opacity 180ms ease,
      filter 260ms ease,
      transform 380ms cubic-bezier(0.2, 0.72, 0.22, 1);
  }


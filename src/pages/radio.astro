---
import AsciiTitle from '../components/AsciiTitle.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/base';

const stationEnabled = import.meta.env.PUBLIC_RADIO_ENABLED !== 'false';
const hlsUrl = import.meta.env.PUBLIC_RADIO_HLS_URL ?? '';
const mp3Url =
  import.meta.env.PUBLIC_RADIO_MP3_URL ??
  'https://lifesteal-signal-api.jade-431.workers.dev/radio/stream.mp3';
const metadataUrl =
  import.meta.env.PUBLIC_RADIO_METADATA_URL ??
  'https://lifesteal-signal-api.jade-431.workers.dev/radio/now-playing.json';
const offlineArtwork = '/assets/radio/offline-placeholder.svg';
---

<BaseLayout
  title="Radio"
  description="The LIFESTEAL live radio signal. One continuous programme shared by every listener."
  image={offlineArtwork}
  page="radio"
>
  <section
    class:list={['radio-console', 'panel', { 'radio-console--offline': !stationEnabled }]}
    data-radio-console
    data-enabled={stationEnabled ? 'true' : 'false'}
    data-hls-url={hlsUrl}
    data-mp3-url={mp3Url}
    data-metadata-url={metadataUrl}
    data-state="offline"
    aria-label="LIFESTEAL radio player"
  >
    <div class="radio-console__art-shell">
      <canvas class="radio-console__visualizer" data-radio-visualizer aria-hidden="true"></canvas>
      <div class="radio-console__artwork-hud">
        <img
          src={withBase(offlineArtwork)}
          alt="LIFESTEAL broadcast offline placeholder"
          width="1080"
          height="1080"
          data-radio-artwork
        />
        <span data-radio-artwork-label>NO MEDIA LOADED</span>
      </div>
      <dl class="radio-console__telemetry" aria-label="Broadcast connection statistics">
        <div><dt>LINK</dt><dd data-radio-transport>STANDBY</dd></div>
        <div><dt>FORMAT</dt><dd data-radio-format>MP3 / 128K</dd></div>
        <div><dt>NETWORK</dt><dd data-radio-network>CHECKING</dd></div>
      </dl>
      <div class="radio-console__signal" aria-hidden="true">
        {
          Array.from({ length: 22 }, (_, index) => (
            <span style={`--bar:${index};--height:${12 + (index % 8) * 10}%`} />
          ))
        }
      </div>
    </div>

    <div class="radio-console__readout">
      <div class="radio-console__topline">
        <span class="live-dot" aria-hidden="true"></span>
        <span data-radio-state>{stationEnabled ? 'READY TO JOIN' : 'SIGNAL OFFLINE'}</span>
        <span>CH.001</span>
      </div>

      <div class="radio-console__metadata">
        <p class="radio-console__artist" data-radio-artist>NO MEDIA LOADED</p>
        <AsciiTitle
          text="STREAM OFFLINE"
          variants={['STREAM OFFLINE']}
          accent="var(--radio-title-accent, #ff304f)"
          id="radio-now-playing"
        />
        <p class="radio-console__album" data-radio-album>CHANNEL IDLE</p>
      </div>

      <div class="radio-console__divider" aria-hidden="true">
        <span></span><span></span><span></span>
      </div>

      <div class="radio-console__controls">
        <button
          class="radio-console__join"
          type="button"
          data-radio-toggle
          disabled={!stationEnabled}
        >
          {stationEnabled ? 'JOIN LIVE SIGNAL' : 'BROADCAST NOT AVAILABLE'}
        </button>
        <label class="radio-console__volume">
          <span>LEVEL</span>
          <input
            data-radio-volume
            type="range"
            min="0"
            max="1"
            step="0.05"
            value="0.8"
            disabled={!stationEnabled}
          />
        </label>
      </div>

      {
        stationEnabled && (
          <p class="radio-console__notice" data-radio-notice>
            Playback begins only after you choose to join. The programme itself is already in
            motion.
          </p>
        )
      }
      <audio data-radio-audio preload="none" crossorigin="anonymous"></audio>
    </div>
  </section>
</BaseLayout>

<script>
  type NowPlaying = {
    status?: 'online' | 'offline';
    artist?: string;
    title?: string;
    album?: string;
    year?: number;
    label?: string;
    artwork?: string;
    palette?: string[];
    broadcast?: {
      bitrateKbps?: number;
      channels?: number;
      codec?: string;
      sampleRate?: number;
    };
  };

  const setupRadio = () => {
    const consoleElement = document.querySelector<HTMLElement>('[data-radio-console]');
    if (consoleElement?.dataset.enabled !== 'true') return;
    const audio = consoleElement.querySelector<HTMLAudioElement>('[data-radio-audio]');
    const toggle = consoleElement.querySelector<HTMLButtonElement>('[data-radio-toggle]');
    const volume = consoleElement.querySelector<HTMLInputElement>('[data-radio-volume]');
    const state = consoleElement.querySelector<HTMLElement>('[data-radio-state]');
    const notice = consoleElement.querySelector<HTMLElement>('[data-radio-notice]');
    const artist = consoleElement.querySelector<HTMLElement>('[data-radio-artist]');
    const album = consoleElement.querySelector<HTMLElement>('[data-radio-album]');
    const artwork = consoleElement.querySelector<HTMLImageElement>('[data-radio-artwork]');
    const artworkLabel = consoleElement.querySelector<HTMLElement>('[data-radio-artwork-label]');
    const visualizerCanvas =
      consoleElement.querySelector<HTMLCanvasElement>('[data-radio-visualizer]');
    const transport = consoleElement.querySelector<HTMLElement>('[data-radio-transport]');
    const format = consoleElement.querySelector<HTMLElement>('[data-radio-format]');
    const network = consoleElement.querySelector<HTMLElement>('[data-radio-network]');
    let hls: { destroy: () => void } | undefined;
    let visualizer:
      | {
          connectAudio: () => Promise<void>;
          destroy: () => void;
          setPalette: (colors: string[]) => void;
        }
      | undefined;
    let metadataTimer = 0;
    let visualizerTimer = 0;
    let loading = false;

    const updateNetworkStats = () => {
      const connection = (
        navigator as Navigator & {
          connection?: { downlink?: number; effectiveType?: string; rtt?: number };
        }
      ).connection;
      if (!network) return;
      if (!connection) {
        network.textContent = navigator.onLine ? 'ONLINE' : 'OFFLINE';
        return;
      }
      const downlink = connection.downlink ? ` / ${connection.downlink.toFixed(1)}M` : '';
      const rtt = connection.rtt ? ` / ${connection.rtt}MS` : '';
      network.textContent = `${(connection.effectiveType ?? 'ONLINE').toUpperCase()}${downlink}${rtt}`;
    };

    const ensureVisualizer = async () => {
      if (
        visualizer ||
        !visualizerCanvas ||
        !audio ||
        window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
        !window.matchMedia('(min-width: 901px)').matches
      )
        return visualizer;
      const { createRadioVisualizer } = await import('../lib/radio-visualizer');
      visualizer = createRadioVisualizer(visualizerCanvas, audio);
      return visualizer;
    };

    const setState = (value: string, machineState: string) => {
      if (state) state.textContent = value;
      consoleElement.dataset.state = machineState;
    };

    const useMp3Fallback = () => {
      if (!audio || !consoleElement.dataset.mp3Url) return;
      hls?.destroy();
      hls = undefined;
      audio.src = consoleElement.dataset.mp3Url;
      if (transport) transport.textContent = 'MP3 / LIVE';
      notice && (notice.textContent = 'HLS unavailable; joined through the continuous MP3 mount.');
    };

    const attachStream = async () => {
      if (!audio || loading) return;
      loading = true;
      audio.crossOrigin = 'anonymous';
      const hlsUrl = consoleElement.dataset.hlsUrl;
      try {
        await ensureVisualizer();
        if (hlsUrl && audio.canPlayType('application/vnd.apple.mpegurl')) {
          audio.src = hlsUrl;
        } else if (hlsUrl) {
          const { default: Hls } = await import('hls.js');
          if (!Hls.isSupported()) {
            useMp3Fallback();
          } else {
            const instance = new Hls({
              liveSyncDurationCount: 3,
              liveMaxLatencyDurationCount: 8,
              enableWorker: true,
            });
            instance.on(Hls.Events.ERROR, (_event, data) => {
              if (data.fatal) useMp3Fallback();
            });
            instance.loadSource(hlsUrl);
            instance.attachMedia(audio);
            hls = instance;
          }
        } else {
          useMp3Fallback();
        }
        await visualizer?.connectAudio();
        await audio.play();
        setState('LIVE / CONNECTED', 'playing');
        if (toggle) toggle.textContent = 'LEAVE LIVE SIGNAL';
      } catch {
        setState('CONNECTION FAILED', 'error');
        if (notice)
          notice.textContent =
            'The signal could not be joined. Check the connection and try again.';
      } finally {
        loading = false;
      }
    };

    const stopStream = () => {
      if (!audio) return;
      audio.pause();
      audio.removeAttribute('src');
      audio.load();
      hls?.destroy();
      hls = undefined;
      setState('READY TO JOIN', 'ready');
      if (transport) transport.textContent = 'STANDBY';
      if (toggle) toggle.textContent = 'JOIN LIVE SIGNAL';
    };

    const refreshMetadata = async () => {
      const url = consoleElement.dataset.metadataUrl;
      if (!url) return;
      try {
        const response = await fetch(url, { cache: 'no-store' });
        if (!response.ok) throw new Error('Metadata unavailable');
        const metadata = (await response.json()) as NowPlaying;
        if (metadata.status === 'offline') throw new Error('Broadcast offline');
        consoleElement.classList.remove('radio-console--offline');
        if (consoleElement.dataset.state === 'offline') setState('READY TO JOIN', 'ready');
        if (metadata.title) {
          window.dispatchEvent(
            new CustomEvent('lifesteal:ascii-title', {
              detail: { id: 'radio-now-playing', text: metadata.title },
            }),
          );
        }
        if (artist && metadata.artist) artist.textContent = metadata.artist;
        if (album) {
          album.textContent = [metadata.album, metadata.year, metadata.label]
            .filter(Boolean)
            .join(' / ');
        }
        const artworkUrl = metadata.artwork
          ? new URL(
              metadata.artwork.startsWith('/') ? `/radio${metadata.artwork}` : metadata.artwork,
              url,
            ).toString()
          : undefined;
        if (artwork && artworkUrl) {
          artwork.src = artworkUrl;
          artwork.alt = `${metadata.artist ?? 'LIFESTEAL'} — ${metadata.title ?? 'now playing'} artwork`;
        }
        if (artworkLabel) artworkLabel.textContent = metadata.title ?? 'LIVE SIGNAL';
        if (metadata.palette?.length) {
          consoleElement.style.setProperty('--radio-title-accent', metadata.palette[0]!);
          (await ensureVisualizer())?.setPalette(metadata.palette);
        }
        if (format && metadata.broadcast) {
          const codec = (metadata.broadcast.codec ?? 'MP3').toUpperCase();
          const bitrate = metadata.broadcast.bitrateKbps
            ? ` / ${metadata.broadcast.bitrateKbps}K`
            : '';
          format.textContent = `${codec}${bitrate}`;
        }
        if ('mediaSession' in navigator && metadata.title) {
          navigator.mediaSession.metadata = new MediaMetadata({
            title: metadata.title,
            artist: metadata.artist,
            album: metadata.album,
            artwork: artworkUrl ? [{ src: artworkUrl }] : [],
          });
        }
      } catch {
        if (audio?.paused) {
          consoleElement.classList.add('radio-console--offline');
          setState('SIGNAL OFFLINE', 'offline');
        }
      }
    };

    toggle?.addEventListener('click', () => {
      if (audio?.paused) attachStream();
      else stopStream();
    });
    volume?.addEventListener('input', () => {
      if (audio) audio.volume = Number(volume.value);
    });
    if (audio && volume) audio.volume = Number(volume.value);
    updateNetworkStats();
    window.addEventListener('online', updateNetworkStats);
    window.addEventListener('offline', updateNetworkStats);
    visualizerTimer = window.setTimeout(() => void ensureVisualizer(), 650);
    refreshMetadata();
    metadataTimer = window.setInterval(refreshMetadata, 10_000);
    document.addEventListener(
      'astro:before-swap',
      () => {
        window.clearInterval(metadataTimer);
        window.clearTimeout(visualizerTimer);
        hls?.destroy();
        visualizer?.destroy();
        window.removeEventListener('online', updateNetworkStats);
        window.removeEventListener('offline', updateNetworkStats);
      },
      { once: true },
    );
  };

  document.addEventListener('astro:page-load', setupRadio);
</script>

<style>
  .radio-console {
    display: grid;
    min-height: 0;
    grid-template-columns: minmax(320px, 0.88fr) minmax(400px, 1.12fr);
    overflow: hidden;
    flex: 1;
  }

  .radio-console__art-shell {
    position: relative;
    min-height: 0;
    overflow: hidden;
    border-right: 1px solid var(--line);
    background: #020203;
  }

  .radio-console__visualizer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .radio-console__artwork-hud {
    position: absolute;
    top: clamp(18px, 3vw, 38px);
    left: clamp(18px, 3vw, 38px);
    width: clamp(130px, 30%, 220px);
    border: 1px solid rgba(244, 241, 234, 0.42);
    background: #030303;
    box-shadow: 0 18px 48px rgba(0, 0, 0, 0.5);
  }

  .radio-console__artwork-hud img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    filter: grayscale(0.35) brightness(0.72);
  }

  .radio-console__artwork-hud span {
    display: block;
    overflow: hidden;
    padding: 8px 10px;
    color: var(--muted);
    font-size: 8px;
    letter-spacing: 0.08em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .radio-console:not(.radio-console--offline) .radio-console__artwork-hud img {
    filter: none;
  }

  .radio-console__telemetry {
    position: absolute;
    top: clamp(18px, 3vw, 38px);
    right: clamp(18px, 3vw, 38px);
    display: grid;
    width: min(210px, 42%);
    margin: 0;
    border-top: 1px solid rgba(244, 241, 234, 0.32);
    background: rgba(0, 0, 0, 0.56);
    backdrop-filter: blur(8px);
  }

  .radio-console__telemetry div {
    display: grid;
    grid-template-columns: auto 1fr;
    padding: 7px 0;
    border-bottom: 1px solid rgba(244, 241, 234, 0.16);
    gap: 12px;
  }

  .radio-console__telemetry dt,
  .radio-console__telemetry dd {
    margin: 0;
    font-size: 8px;
    letter-spacing: 0.08em;
  }

  .radio-console__telemetry dt {
    color: var(--muted);
  }

  .radio-console__telemetry dd {
    overflow: hidden;
    color: var(--white);
    text-align: right;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .radio-console__signal {
    position: absolute;
    right: 18px;
    bottom: 18px;
    left: 18px;
    display: flex;
    align-items: flex-end;
    height: 70px;
    gap: 5px;
  }

  .radio-console__signal span {
    width: 100%;
    height: var(--height);
    background: rgba(244, 241, 234, 0.25);
    transform-origin: bottom;
  }

  .radio-console[data-state='playing'] .radio-console__signal span {
    background: var(--magenta);
    box-shadow: 0 0 8px rgba(242, 166, 255, 0.65);
    animation: meter calc(420ms + var(--bar) * 19ms) ease-in-out infinite alternate;
  }

  .radio-console__readout {
    display: flex;
    min-width: 0;
    padding: clamp(22px, 3.8vh, 48px) clamp(28px, 4.2vw, 64px);
    flex-direction: column;
    justify-content: center;
  }

  .radio-console__topline {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    padding-bottom: 13px;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: 9px;
    letter-spacing: 0.1em;
    gap: 10px;
  }

  .live-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--red);
  }

  .radio-console[data-state='playing'] .live-dot {
    box-shadow: 0 0 12px var(--red);
    animation: pulse 1.1s steps(2, end) infinite;
  }

  .radio-console__metadata {
    padding: clamp(20px, 3.4vh, 42px) 0 clamp(15px, 2.3vh, 28px);
  }

  .radio-console__artist {
    margin: 0;
    color: var(--white);
    font-size: 12px;
    letter-spacing: 0.12em;
  }

  .radio-console--offline .radio-console__artist {
    color: var(--muted);
  }

  .radio-console__album {
    margin: 0;
    color: var(--muted);
    font-size: 10px;
    letter-spacing: 0.08em;
  }

  .radio-console__divider {
    display: grid;
    grid-template-columns: 1fr 14px 7px;
    gap: 7px;
  }

  .radio-console__divider span {
    height: 2px;
    background: var(--line-strong);
  }

  .radio-console__divider span:first-child {
    background: var(--line-strong);
  }

  .radio-console[data-state='playing'] .radio-console__divider span:first-child {
    background: var(--radio-title-accent, var(--accent));
    box-shadow: 0 0 9px
      color-mix(in srgb, var(--radio-title-accent, var(--accent)) 70%, transparent);
  }

  .radio-console__controls {
    display: grid;
    grid-template-columns: 1fr minmax(150px, 0.55fr);
    margin-top: clamp(14px, 2vh, 24px);
    gap: 14px;
  }

  .radio-console__join {
    min-height: 54px;
    border: 1px solid var(--magenta);
    background: rgba(242, 166, 255, 0.05);
    color: var(--white);
    font-size: 11px;
    letter-spacing: 0.08em;
    cursor: pointer;
  }

  .radio-console__join:not(:disabled):hover {
    box-shadow:
      inset 0 0 25px rgba(242, 166, 255, 0.12),
      0 0 16px rgba(242, 166, 255, 0.14);
  }

  .radio-console__join:disabled {
    border-style: dashed;
    border-color: var(--line-strong);
    color: var(--muted);
    cursor: not-allowed;
  }

  .radio-console__volume {
    display: grid;
    align-content: center;
    padding: 7px 12px;
    border: 1px solid var(--line);
    color: var(--muted);
    font-size: 9px;
    gap: 5px;
  }

  .radio-console__volume input {
    width: 100%;
    accent-color: var(--magenta);
  }

  .radio-console__notice {
    margin: clamp(10px, 1.5vh, 18px) 0 0;
    color: var(--muted);
    font-size: 10px;
  }

  .radio-console--offline .live-dot {
    background: #625f5d;
  }

  .radio-console--offline {
    --radio-title-accent: #ff304f;
  }

  @keyframes meter {
    from {
      transform: scaleY(0.26);
    }
    to {
      transform: scaleY(1);
    }
  }

  @keyframes pulse {
    50% {
      opacity: 0.35;
    }
  }

  @media (max-width: 900px) {
    .radio-console {
      grid-template-columns: 1fr;
      flex: none;
    }

    .radio-console__art-shell {
      height: clamp(210px, 26svh, 260px);
      min-height: 0;
      border-right: 0;
      border-bottom: 1px solid var(--line);
      aspect-ratio: auto;
    }

    .radio-console__visualizer,
    .radio-console__telemetry {
      display: none;
    }

    .radio-console__artwork-hud {
      inset: 0;
      width: 100%;
      border: 0;
      box-shadow: none;
    }

    .radio-console__artwork-hud img {
      width: 100%;
      height: 100%;
      aspect-ratio: auto;
      object-fit: cover;
    }

    .radio-console__artwork-hud span {
      position: absolute;
      right: 0;
      bottom: 0;
      left: 0;
      background: rgba(0, 0, 0, 0.72);
    }
  }

  @media (max-width: 580px) {
    .radio-console__readout {
      padding: 30px 22px 38px;
    }

    .radio-console__controls {
      grid-template-columns: 1fr;
    }
  }
</style>

---
import ReleaseCard from '../components/ReleaseCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { releases } from '../lib/content';

const initialPalette = releases[0]?.palette;
const galleryStyle = initialPalette
  ? [
      `--gallery-background:${initialPalette.background}`,
      `--gallery-surface:${initialPalette.surface}`,
      `--gallery-foreground:${initialPalette.foreground}`,
      `--gallery-accent:${initialPalette.accent}`,
      `--gallery-glow:${initialPalette.glow}`,
    ].join(';')
  : undefined;
const metricsEndpoint =
  import.meta.env.PUBLIC_METRICS_ENDPOINT ??
  'https://lifesteal-signal-api.jade-431.workers.dev/metrics';
---

<BaseLayout
  title="Releases"
  description="Releases and forthcoming transmissions from LIFESTEAL artists."
  page="releases"
>
  <section
    class="snap-gallery release-gallery panel"
    data-gallery
    data-metrics-endpoint={metricsEndpoint}
    aria-label="LIFESTEAL releases"
    tabindex="0"
    style={galleryStyle}
  >
    <div class="snap-gallery__viewport" data-gallery-viewport tabindex="0">
      {
        releases.map((release, index) => (
          <div
            class="release-slide"
            id={release.canonicalId}
            data-gallery-slide
            data-gallery-id={release.canonicalId}
            data-gallery-background={release.palette.background}
            data-gallery-surface={release.palette.surface}
            data-gallery-foreground={release.palette.foreground}
            data-gallery-accent={release.palette.accent}
            data-gallery-glow={release.palette.glow}
            aria-label={`${index + 1} of ${releases.length}: ${release.title}`}
            tabindex="0"
          >
            <ReleaseCard release={release} index={index} />
          </div>
        ))
      }
    </div>

    <div class="snap-gallery__controls">
      <div class="snap-gallery__markers" aria-label="Select release">
        {
          releases.map((release, index) => (
            <button
              type="button"
              data-gallery-marker
              aria-label={`Show ${release.title}`}
              aria-current={index === 0 ? 'true' : undefined}
              tabindex={index === 0 ? 0 : -1}
            >
              <span>{String(index + 1).padStart(2, '0')}</span>
            </button>
          ))
        }
      </div>
      <span class="snap-gallery__hint">SCROLL / SWIPE / ARROW KEYS</span>
      <output data-gallery-position aria-live="polite">
        01 / {String(releases.length).padStart(2, '0')}
      </output>
    </div>
  </section>
</BaseLayout>

<script>
  import { setupSnapGallery } from '../lib/snap-gallery';
  import { formatCount } from '../lib/format';

  type LiveMetric = {
    canonicalId: string;
    platform: string;
    kind: 'plays' | 'popularity';
    value: number;
    asOf: string;
  };

  const metricLabel = (metric: LiveMetric) =>
    metric.kind === 'popularity'
      ? `${metric.platform.toUpperCase()} POPULARITY`
      : `${metric.platform.toUpperCase()} PLAYS`;

  const updateMetric = (metric: LiveMetric) => {
    const release = document.querySelector<HTMLElement>(
      `[data-release-id="${CSS.escape(metric.canonicalId)}"]`,
    );
    const list = release?.querySelector<HTMLUListElement>('[data-release-metrics]');
    if (!list || !Number.isFinite(metric.value) || metric.value < 0) return;
    let item = list.querySelector<HTMLLIElement>(
      `[data-platform-metric][data-platform="${CSS.escape(metric.platform)}"][data-kind="${CSS.escape(metric.kind)}"]`,
    );
    if (!item) {
      item = document.createElement('li');
      item.dataset.platformMetric = '';
      item.dataset.platform = metric.platform;
      item.dataset.kind = metric.kind;
      item.innerHTML =
        '<span data-metric-label></span><strong data-metric-value></strong><small data-metric-date></small>';
      list.append(item);
    }
    const label = item.querySelector<HTMLElement>('[data-metric-label]');
    const value = item.querySelector<HTMLElement>('[data-metric-value]');
    const date = item.querySelector<HTMLElement>('[data-metric-date]');
    if (label) label.textContent = metricLabel(metric);
    if (value) {
      value.textContent =
        metric.kind === 'popularity' ? `${metric.value}/100` : formatCount(metric.value);
    }
    if (date) {
      date.textContent = `AS OF ${new Date(metric.asOf).toLocaleDateString('en-AU')}`;
    }
    list.hidden = false;
  };

  const updateReleaseTotals = (metrics: LiveMetric[]) => {
    const grouped = new Map<string, LiveMetric[]>();
    metrics
      .filter((metric) => metric.kind === 'plays')
      .forEach((metric) =>
        grouped.set(metric.canonicalId, [...(grouped.get(metric.canonicalId) ?? []), metric]),
      );
    grouped.forEach((playMetrics, canonicalId) => {
      const release = document.querySelector<HTMLElement>(
        `[data-release-id="${CSS.escape(canonicalId)}"]`,
      );
      const list = release?.querySelector<HTMLUListElement>('[data-release-metrics]');
      const totalItem = list?.querySelector<HTMLLIElement>('[data-total-metric]');
      if (!list || !totalItem) return;
      const total = playMetrics.reduce((sum, metric) => sum + metric.value, 0);
      const latest = playMetrics
        .map((metric) => metric.asOf)
        .sort()
        .at(-1);
      const value = totalItem.querySelector<HTMLElement>('[data-total-metric-value]');
      const date = totalItem.querySelector<HTMLElement>('[data-total-metric-date]');
      if (value) value.textContent = formatCount(total);
      if (date && latest)
        date.textContent = `AS OF ${new Date(latest).toLocaleDateString('en-AU')}`;
      totalItem.hidden = false;
      list.hidden = false;
    });
  };

  const hydrateMetrics = async (gallery: HTMLElement) => {
    if (gallery.dataset.metricsHydrated === 'true') return;
    gallery.dataset.metricsHydrated = 'true';
    const endpoint = gallery.dataset.metricsEndpoint;
    if (!endpoint) return;
    try {
      const response = await fetch(endpoint, { headers: { Accept: 'application/json' } });
      if (!response.ok) return;
      const payload = (await response.json()) as { metrics?: LiveMetric[] };
      payload.metrics?.forEach(updateMetric);
      updateReleaseTotals(payload.metrics ?? []);
    } catch {
      // Static, timestamped values remain visible whenever the live endpoint is unavailable.
    }
  };

  const setupReleases = () => {
    document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
      setupSnapGallery(gallery);
      void hydrateMetrics(gallery);
    });
  };

  document.addEventListener('astro:page-load', setupReleases);
</script>

<style>
  .release-gallery {
    display: flex;
    min-height: 0;
    overflow: hidden;
    flex: 1;
    flex-direction: column;
    border-color: color-mix(in srgb, var(--gallery-accent), transparent 58%);
    background: var(--gallery-background);
    box-shadow: 0 0 45px color-mix(in srgb, var(--gallery-glow), transparent 94%);
    transition:
      background-color 180ms linear,
      border-color 180ms linear,
      box-shadow 180ms linear;
  }

  .snap-gallery__viewport {
    display: flex;
    min-width: 0;
    min-height: 0;
    overflow-x: auto;
    overflow-y: hidden;
    flex: 1;
    scrollbar-color: var(--gallery-accent) color-mix(in srgb, var(--gallery-surface), #000 50%);
    scrollbar-width: thin;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
  }

  .snap-gallery__viewport::-webkit-scrollbar {
    height: 8px;
  }

  .snap-gallery__viewport::-webkit-scrollbar-track {
    background: color-mix(in srgb, var(--gallery-surface), #000 50%);
  }

  .snap-gallery__viewport::-webkit-scrollbar-thumb {
    border: 2px solid color-mix(in srgb, var(--gallery-surface), #000 50%);
    background: var(--gallery-accent);
  }

  .release-slide {
    min-width: 100%;
    min-height: 0;
    overflow: hidden;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  .release-slide :global(.release-card) {
    height: 100%;
    border: 0;
  }

  .snap-gallery__controls {
    display: grid;
    min-height: 44px;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    padding: 0 14px;
    border-top: 1px solid color-mix(in srgb, var(--gallery-accent), transparent 65%);
    background: color-mix(in srgb, var(--gallery-surface), #000 36%);
    color: color-mix(in srgb, var(--gallery-foreground), transparent 22%);
    font-size: 9px;
    letter-spacing: 0.09em;
    gap: 18px;
  }

  .snap-gallery__markers {
    display: flex;
    min-width: 0;
    align-items: stretch;
    align-self: stretch;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .snap-gallery__markers::-webkit-scrollbar {
    display: none;
  }

  .snap-gallery__markers button {
    min-width: 42px;
    border: 0;
    border-right: 1px solid color-mix(in srgb, var(--gallery-accent), transparent 78%);
    background: transparent;
    color: inherit;
    font-size: 9px;
    cursor: pointer;
  }

  .snap-gallery__markers button[aria-current='true'] {
    background: color-mix(in srgb, var(--gallery-accent), transparent 85%);
    color: var(--gallery-foreground);
    text-shadow: 0 0 8px var(--gallery-glow);
  }

  .snap-gallery__controls output {
    color: var(--gallery-foreground);
    text-shadow: 0 0 8px color-mix(in srgb, var(--gallery-glow), transparent 35%);
  }

  @media (max-width: 900px) {
    .release-gallery {
      height: auto;
      min-height: calc(100svh - var(--header-height) - var(--mobile-footer-height));
      flex: 1;
    }

    .release-slide {
      overflow-y: auto;
    }

    .release-slide :global(.release-card) {
      height: auto;
      min-height: 100%;
    }

    .snap-gallery__hint {
      display: none;
    }

    .snap-gallery__controls {
      grid-template-columns: 1fr auto;
    }
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import AsciiTitle from '../components/AsciiTitle.astro';
---

<BaseLayout
  title="About"
  description="LIFESTEAL is an independent record label and alternative lifestyle brand founded in 2021 and based in Naarm."
  page="about"
>
  <section class="contact-terminal panel" itemscope itemtype="https://schema.org/Organization">
    <meta itemprop="name" content="LIFESTEAL" />
    <div class="contact-terminal__output">
      <a
        class="contact-terminal__email"
        itemprop="email"
        href="mailto:hello@lifesteal.world"
        aria-label="hello@lifesteal.world"
      >
        <AsciiTitle text="hello@lifesteal.world" accent="var(--accent)" />
      </a>
      <p>Copyright / collaboration / booking / events / general contact</p>
    </div>
    <div class="contact-terminal__facts">
      <dl>
        <div>
          <dt>TYPE</dt><dd>
            RECORD LABEL / ALTERNATIVE LIFESTYLE BRAND / LIVE PERFORMANCE / MERCHANDISING /
            MANAGEMENT
          </dd>
        </div>
        <div><dt>FOUNDED</dt><dd>2021</dd></div>
        <div><dt>BASE</dt><dd itemprop="address">NORTHCOTE, NAARM, AUSTRALIA</dd></div>
        <div><dt>STATUS</dt><dd class="contact-terminal__online">ACTIVE</dd></div>
      </dl>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-terminal {
    display: grid;
    min-height: 0;
    grid-template-rows: minmax(0, 1fr) auto;
    overflow: hidden;
    flex: 1;
  }

  .contact-terminal__output {
    display: flex;
    padding: clamp(34px, 7vh, 78px) clamp(34px, 6vw, 88px);
    border-bottom: 1px solid var(--line);
    flex-direction: column;
    justify-content: center;
  }

  .contact-terminal__email {
    display: block;
    width: min(100%, 1080px);
    margin: 0 0 clamp(14px, 2.2vh, 24px);
    text-decoration: none;
  }

  .contact-terminal__email:hover {
    text-shadow: none;
  }

  .contact-terminal__email :global(.ascii-card-title pre) {
    margin-top: 0;
  }

  .contact-terminal__output p {
    margin: 0;
    color: var(--muted);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .contact-terminal__facts {
    padding: clamp(13px, 2vh, 21px) clamp(24px, 5vw, 72px);
  }

  .contact-terminal__facts dl {
    display: grid;
    grid-template-columns: minmax(300px, 2.2fr) repeat(3, minmax(120px, 1fr));
    margin: 0;
    gap: 20px;
  }

  .contact-terminal__facts div {
    min-width: 0;
  }

  .contact-terminal__facts dt {
    color: var(--red);
    font-size: 9px;
    letter-spacing: 0.1em;
    animation: accent-prism-glow 9s ease-in-out infinite;
  }

  .contact-terminal__facts dd {
    margin: 4px 0 0;
    color: #cbc7c0;
    font-size: 10px;
  }

  .contact-terminal__online {
    color: var(--green) !important;
    text-shadow: 0 0 8px rgba(144, 255, 154, 0.5);
  }

  @media (max-width: 800px) {
    .contact-terminal__facts dl {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 520px) {
    .contact-terminal {
      grid-template-rows: auto auto;
    }

    .contact-terminal__output {
      padding: 42px 22px;
    }

    .contact-terminal__facts dl {
      grid-template-columns: 1fr;
    }
  }
</style>

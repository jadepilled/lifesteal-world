---
import PageHeading from '../components/PageHeading.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { artists } from '../lib/content';
import { withBase } from '../lib/base';

const initialPalette = artists[0]?.palette;
const galleryStyle = initialPalette
  ? [
      `--gallery-background:${initialPalette.background}`,
      `--gallery-surface:${initialPalette.surface}`,
      `--gallery-foreground:${initialPalette.foreground}`,
      `--gallery-accent:${initialPalette.accent}`,
      `--gallery-glow:${initialPalette.glow}`,
    ].join(';')
  : undefined;
---

<BaseLayout
  title="Artists"
  description="Meet the artists on LIFESTEAL: HAZELMERE and starstrike."
  page="artists"
>
  <PageHeading title="artists" status={`${artists.length.toString().padStart(2, '0')} RECORDS`} />

  <section
    class="snap-gallery artist-gallery panel"
    data-gallery
    aria-label="LIFESTEAL artists"
    tabindex="0"
    style={galleryStyle}
  >
    <div class="snap-gallery__viewport" data-gallery-viewport tabindex="0">
      {
        artists.map((artist, index) => {
          const paletteStyle = [
            `--artist-background:${artist.palette.background}`,
            `--artist-surface:${artist.palette.surface}`,
            `--artist-foreground:${artist.palette.foreground}`,
            `--artist-accent:${artist.palette.accent}`,
            `--artist-glow:${artist.palette.glow}`,
          ].join(';');

          return (
            <article
              class="artist-slide"
              id={artist.slug}
              data-gallery-slide
              data-gallery-id={artist.slug}
              data-gallery-background={artist.palette.background}
              data-gallery-surface={artist.palette.surface}
              data-gallery-foreground={artist.palette.foreground}
              data-gallery-accent={artist.palette.accent}
              data-gallery-glow={artist.palette.glow}
              style={paletteStyle}
              aria-label={`${index + 1} of ${artists.length}: ${artist.displayName}`}
            >
              <div class="artist-slide__image-wrap">
                <img
                  class="artist-slide__image"
                  src={withBase(artist.portrait.src)}
                  alt={artist.portrait.alt}
                  width={artist.id === 'starstrike' ? 2660 : 1200}
                  height={artist.id === 'starstrike' ? 1140 : 1200}
                  loading={index === 0 ? 'eager' : 'lazy'}
                  fetchpriority={index === 0 ? 'high' : 'auto'}
                  style={`object-position:${artist.portrait.focalPoint ?? '50% 50%'}`}
                />
                <span class="artist-slide__tint" aria-hidden="true" />
                <span class="artist-slide__scan" aria-hidden="true" />
              </div>

              <div class="artist-slide__copy">
                <span class="eyebrow">ARTIST / {String(index + 1).padStart(2, '0')}</span>
                <h2>{artist.displayName}</h2>
                <dl class="artist-meta">
                  <div>
                    <>
                      <dt>ACTIVE</dt>
                      <dd>{artist.activeYears}</dd>
                    </>
                  </div>
                  <div>
                    <>
                      <dt>LOCATION</dt>
                      <dd>{artist.location}</dd>
                    </>
                  </div>
                  <div>
                    <>
                      <dt>GENRE</dt>
                      <dd>{artist.genres.join(' / ')}</dd>
                    </>
                  </div>
                </dl>
                <p class="artist-biography">{artist.biography}</p>
                <ul class="artist-links" aria-label={`${artist.displayName} links`}>
                  {artist.links.map((link) => (
                    <li>
                      <a class="button-link" href={link.url} target="_blank" rel="noreferrer">
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </article>
          );
        })
      }
    </div>

    <div class="snap-gallery__controls">
      <div class="snap-gallery__markers" aria-label="Select artist">
        {
          artists.map((artist, index) => (
            <button
              type="button"
              data-gallery-marker
              aria-label={`Show ${artist.displayName}`}
              aria-current={index === 0 ? 'true' : undefined}
              tabindex={index === 0 ? 0 : -1}
            >
              <span>{String(index + 1).padStart(2, '0')}</span>
            </button>
          ))
        }
      </div>
      <span class="snap-gallery__hint">SCROLL / SWIPE / ARROW KEYS</span>
      <output data-gallery-position aria-live="polite">
        01 / {String(artists.length).padStart(2, '0')}
      </output>
    </div>
  </section>
</BaseLayout>

<script>
  import { setupSnapGallery } from '../lib/snap-gallery';

  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach(setupSnapGallery);
</script>

<style>
  .artist-gallery {
    display: flex;
    min-height: 0;
    overflow: hidden;
    flex: 1;
    flex-direction: column;
    border-color: color-mix(in srgb, var(--gallery-accent), transparent 58%);
    background: var(--gallery-background);
    box-shadow: 0 0 45px color-mix(in srgb, var(--gallery-glow), transparent 94%);
    transition:
      background-color 180ms linear,
      border-color 180ms linear,
      box-shadow 180ms linear;
  }

  .snap-gallery__viewport {
    display: flex;
    min-width: 0;
    min-height: 0;
    overflow-x: auto;
    overflow-y: hidden;
    flex: 1;
    scrollbar-color: var(--gallery-accent) color-mix(in srgb, var(--gallery-surface), #000 50%);
    scrollbar-width: thin;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
  }

  .snap-gallery__viewport::-webkit-scrollbar {
    height: 8px;
  }

  .snap-gallery__viewport::-webkit-scrollbar-track {
    background: color-mix(in srgb, var(--gallery-surface), #000 50%);
  }

  .snap-gallery__viewport::-webkit-scrollbar-thumb {
    border: 2px solid color-mix(in srgb, var(--gallery-surface), #000 50%);
    background: var(--gallery-accent);
  }

  .artist-slide {
    display: grid;
    min-width: 100%;
    min-height: 0;
    grid-template-columns: minmax(280px, 0.9fr) minmax(390px, 1.1fr);
    overflow: hidden;
    background:
      radial-gradient(
        circle at 100% 0,
        color-mix(in srgb, var(--artist-accent), transparent 84%),
        transparent 48%
      ),
      var(--artist-background);
    color: var(--artist-foreground);
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  .artist-slide__image-wrap {
    position: relative;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    border-right: 1px solid color-mix(in srgb, var(--artist-accent), transparent 65%);
    background: var(--artist-surface);
  }

  .artist-slide__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: contrast(1.08) saturate(0.88);
  }

  .artist-slide__tint,
  .artist-slide__scan {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .artist-slide__tint {
    background: color-mix(in srgb, var(--artist-accent), transparent 82%);
    mix-blend-mode: color;
  }

  .artist-slide__scan {
    background: linear-gradient(
      105deg,
      transparent 30%,
      color-mix(in srgb, var(--artist-foreground), transparent 92%),
      transparent 55%
    );
    background-size: 250% 100%;
    mix-blend-mode: screen;
    animation: artist-scan 9s linear infinite;
  }

  .artist-slide__copy {
    display: flex;
    min-width: 0;
    min-height: 0;
    padding: clamp(24px, 4.2vh, 58px) clamp(28px, 4.2vw, 66px);
    flex-direction: column;
    justify-content: center;
  }

  .artist-slide .eyebrow,
  .artist-meta dt,
  .artist-slide :global(.button-link)::before {
    color: var(--artist-accent);
  }

  .artist-slide h2 {
    margin: 5px 0 clamp(15px, 2.2vh, 27px);
    font-family: var(--display);
    font-size: clamp(58px, 8.2vh, 106px);
    font-weight: 900;
    line-height: 0.8;
    letter-spacing: -0.05em;
    text-shadow: 0 0 22px color-mix(in srgb, var(--artist-glow), transparent 65%);
  }

  .artist-meta {
    display: grid;
    width: 100%;
    margin: 0 0 clamp(14px, 2vh, 24px);
    gap: 6px;
  }

  .artist-meta div {
    display: grid;
    grid-template-columns: 84px 1fr;
    padding-bottom: 6px;
    border-bottom: 1px dotted color-mix(in srgb, var(--artist-accent), transparent 72%);
  }

  .artist-meta dt {
    font-size: 9px;
    letter-spacing: 0.08em;
  }

  .artist-meta dd {
    margin: 0;
    color: color-mix(in srgb, var(--artist-foreground), transparent 16%);
    font-size: 11px;
  }

  .artist-biography {
    max-width: 680px;
    margin-bottom: 0;
    color: color-mix(in srgb, var(--artist-foreground), transparent 22%);
    font-size: clamp(11px, 1.35vh, 14px);
    line-height: 1.55;
  }

  .artist-links {
    display: flex;
    padding: 0;
    margin: clamp(10px, 1.8vh, 18px) 0 0;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
  }

  .artist-links :global(.button-link) {
    min-height: 38px;
    padding: 7px 13px;
    border-color: color-mix(in srgb, var(--artist-accent), transparent 52%);
    background: color-mix(in srgb, var(--artist-surface), transparent 12%);
  }

  .snap-gallery__controls {
    display: grid;
    min-height: 44px;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    padding: 0 14px;
    border-top: 1px solid color-mix(in srgb, var(--gallery-accent), transparent 65%);
    background: color-mix(in srgb, var(--gallery-surface), #000 36%);
    color: color-mix(in srgb, var(--gallery-foreground), transparent 48%);
    font-size: 9px;
    letter-spacing: 0.09em;
    gap: 18px;
  }

  .snap-gallery__markers {
    display: flex;
    align-items: stretch;
    align-self: stretch;
  }

  .snap-gallery__markers button {
    min-width: 42px;
    border: 0;
    border-right: 1px solid color-mix(in srgb, var(--gallery-accent), transparent 78%);
    background: transparent;
    color: inherit;
    font-size: 9px;
    cursor: pointer;
  }

  .snap-gallery__markers button[aria-current='true'] {
    background: color-mix(in srgb, var(--gallery-accent), transparent 85%);
    color: var(--gallery-foreground);
    text-shadow: 0 0 8px var(--gallery-glow);
  }

  .snap-gallery__controls output {
    color: var(--gallery-accent);
    text-shadow: 0 0 8px color-mix(in srgb, var(--gallery-glow), transparent 35%);
  }

  @keyframes artist-scan {
    to {
      background-position: -250% 0;
    }
  }

  @media (max-width: 900px) {
    .artist-gallery {
      min-height: min(760px, calc(100svh - 190px));
      flex: none;
    }

    .artist-slide {
      grid-template-columns: 1fr;
      grid-template-rows: minmax(260px, 48%) 1fr;
    }

    .artist-slide__image-wrap {
      border-right: 0;
      border-bottom: 1px solid color-mix(in srgb, var(--artist-accent), transparent 65%);
    }

    .artist-slide__copy {
      justify-content: flex-start;
      padding: 28px 22px 36px;
      overflow-y: auto;
    }

    .artist-slide h2 {
      font-size: clamp(54px, 17vw, 96px);
    }

    .snap-gallery__hint {
      display: none;
    }

    .snap-gallery__controls {
      grid-template-columns: 1fr auto;
    }
  }

  @media (max-width: 540px) {
    .artist-gallery {
      min-height: 720px;
    }

    .artist-meta div {
      grid-template-columns: 72px 1fr;
    }
  }
</style>

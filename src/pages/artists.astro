---
import AsciiTitle from '../components/AsciiTitle.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { artists, releases } from '../lib/content';
import { withBase } from '../lib/base';
import { formatCount } from '../lib/format';

const initialPalette = artists[0]?.palette;
const galleryStyle = initialPalette
  ? [
      `--gallery-background:${initialPalette.background}`,
      `--gallery-surface:${initialPalette.surface}`,
      `--gallery-foreground:${initialPalette.foreground}`,
      `--gallery-accent:${initialPalette.accent}`,
      `--gallery-glow:${initialPalette.glow}`,
    ].join(';')
  : undefined;
const metricsEndpoint =
  import.meta.env.PUBLIC_METRICS_ENDPOINT ??
  'https://lifesteal-signal-api.jade-431.workers.dev/metrics';
---

<BaseLayout
  title="Artists"
  description="Meet the artists on LIFESTEAL: HAZELMERE and starstrike."
  page="artists"
>
  <section
    class="snap-gallery artist-gallery panel accent-prism-frame"
    data-gallery
    data-metrics-endpoint={metricsEndpoint}
    aria-label="LIFESTEAL artists"
    tabindex="0"
    style={galleryStyle}
  >
    <div class="snap-gallery__viewport" data-gallery-viewport tabindex="0">
      {
        artists.map((artist, index) => {
          const totalPlays = releases
            .filter((release) => release.artistIds.includes(artist.id))
            .flatMap((release) => release.metrics)
            .filter((metric) => metric.kind === 'plays')
            .reduce((sum, metric) => sum + metric.value, 0);
          const paletteStyle = [
            `--artist-background:${artist.palette.background}`,
            `--artist-surface:${artist.palette.surface}`,
            `--artist-foreground:${artist.palette.foreground}`,
            `--artist-accent:${artist.palette.accent}`,
            `--artist-glow:${artist.palette.glow}`,
          ].join(';');

          return (
            <article
              class="artist-slide accent-prism-frame"
              id={artist.slug}
              data-gallery-slide
              data-gallery-id={artist.slug}
              data-artist-id={artist.id}
              data-gallery-background={artist.palette.background}
              data-gallery-surface={artist.palette.surface}
              data-gallery-foreground={artist.palette.foreground}
              data-gallery-accent={artist.palette.accent}
              data-gallery-glow={artist.palette.glow}
              data-panel-open="info"
              style={paletteStyle}
              aria-label={`${index + 1} of ${artists.length}: ${artist.displayName}`}
            >
              <div class="artist-slide__image-wrap">
                <img
                  class="artist-slide__image"
                  src={withBase(artist.portrait.src)}
                  alt={artist.portrait.alt}
                  width={artist.id === 'starstrike' ? 2660 : 1200}
                  height={artist.id === 'starstrike' ? 1140 : 1200}
                  loading={index === 0 ? 'eager' : 'lazy'}
                  fetchpriority={index === 0 ? 'high' : 'auto'}
                  style={`object-position:${artist.portrait.focalPoint ?? '50% 50%'}`}
                />
                <span class="artist-slide__tint" aria-hidden="true" />
                <span class="artist-slide__scan" aria-hidden="true" />
              </div>

              <div class="artist-slide__copy">
                <span class="eyebrow accent-prism-text">
                  ARTIST / {String(index + 1).padStart(2, '0')}
                </span>
                <AsciiTitle text={artist.displayName} accent="var(--artist-accent)" />
                <div
                  class="artist-mobile-tabs"
                  aria-label={`${artist.displayName} record sections`}
                >
                  <button
                    class="accent-prism-frame"
                    type="button"
                    data-artist-panel-button="info"
                    aria-controls={`${artist.slug}-info`}
                    aria-expanded="true"
                  >
                    INFO
                  </button>
                  <button
                    class="accent-prism-frame"
                    type="button"
                    data-artist-panel-button="stats"
                    aria-controls={`${artist.slug}-stats`}
                    aria-expanded="false"
                  >
                    STATS
                  </button>
                  <button
                    class="accent-prism-frame"
                    type="button"
                    data-artist-panel-button="links"
                    aria-controls={`${artist.slug}-links`}
                    aria-expanded="false"
                  >
                    LINKS
                  </button>
                </div>
                <div
                  class="artist-slide__panel artist-slide__panel--info"
                  id={`${artist.slug}-info`}
                  data-artist-panel="info"
                  data-open="true"
                >
                  <dl class="artist-meta">
                    <div>
                      <>
                        <dt class="accent-prism-text">ACTIVE</dt>
                        <dd>{artist.activeYears}</dd>
                      </>
                    </div>
                    <div>
                      <>
                        <dt class="accent-prism-text">LOCATION</dt>
                        <dd>{artist.location}</dd>
                      </>
                    </div>
                    <div>
                      <>
                        <dt class="accent-prism-text">GENRE</dt>
                        <dd>{artist.genres.join(' / ')}</dd>
                      </>
                    </div>
                  </dl>
                  <p class="artist-biography">{artist.biography}</p>
                </div>
                <div
                  class="artist-slide__panel artist-slide__panel--stats"
                  id={`${artist.slug}-stats`}
                  data-artist-panel="stats"
                >
                  <ul class="artist-stats" aria-label={`${artist.displayName} audience statistics`}>
                    <li class="accent-prism-frame">
                      <span>TOTAL PLAYS</span>
                      <strong class="accent-prism-text" data-artist-metric="totalPlays">
                        {formatCount(totalPlays)}
                      </strong>
                    </li>
                    <li class="accent-prism-frame">
                      <span>PLAYS (30D)</span>
                      <strong class="accent-prism-text" data-artist-metric="plays30d">
                        {artist.metricsSnapshot.plays30d === null
                          ? 'COLLECTING'
                          : formatCount(artist.metricsSnapshot.plays30d)}
                      </strong>
                    </li>
                    <li class="accent-prism-frame">
                      <span>SOUNDCLOUD FOLLOWERS</span>
                      <strong class="accent-prism-text" data-artist-metric="soundcloudFollowers">
                        {artist.metricsSnapshot.soundcloudFollowers === null
                          ? '—'
                          : formatCount(artist.metricsSnapshot.soundcloudFollowers)}
                      </strong>
                    </li>
                    <li class="accent-prism-frame">
                      <span>SPOTIFY MONTHLY</span>
                      <strong
                        class="accent-prism-text"
                        data-artist-metric="spotifyMonthlyListeners"
                      >
                        {artist.metricsSnapshot.spotifyMonthlyListeners === null
                          ? '—'
                          : formatCount(artist.metricsSnapshot.spotifyMonthlyListeners)}
                      </strong>
                    </li>
                  </ul>
                </div>
                <div
                  class="artist-slide__panel artist-slide__panel--links"
                  id={`${artist.slug}-links`}
                  data-artist-panel="links"
                >
                  <ul class="artist-links" aria-label={`${artist.displayName} links`}>
                    {artist.links.map((link) => (
                      <li>
                        <a
                          class="button-link accent-prism-frame"
                          href={link.url}
                          target="_blank"
                          rel="noreferrer"
                        >
                          {link.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>

    <div class="snap-gallery__controls">
      <div class="snap-gallery__markers" aria-label="Select artist">
        {
          artists.map((artist, index) => (
            <button
              class="accent-prism-frame"
              type="button"
              data-gallery-marker
              aria-label={`Show ${artist.displayName}`}
              aria-current={index === 0 ? 'true' : undefined}
              tabindex={index === 0 ? 0 : -1}
            >
              <span>{String(index + 1).padStart(2, '0')}</span>
            </button>
          ))
        }
      </div>
      <span class="snap-gallery__hint">SCROLL / SWIPE / ARROW KEYS</span>
      <output data-gallery-position aria-live="polite">
        01 / {String(artists.length).padStart(2, '0')}
      </output>
    </div>
  </section>
</BaseLayout>

<script>
  import { setupSnapGallery } from '../lib/snap-gallery';
  import { formatCount } from '../lib/format';

  type ArtistMetric = {
    artistId: string;
    totalPlays: number;
    plays30d: number | null;
    soundcloudFollowers: number | null;
    spotifyMonthlyListeners: number | null;
  };

  const hydrateArtistMetrics = async (gallery: HTMLElement) => {
    if (gallery.dataset.artistMetricsHydrated === 'true') return;
    gallery.dataset.artistMetricsHydrated = 'true';
    const endpoint = gallery.dataset.metricsEndpoint;
    if (!endpoint) return;
    try {
      const response = await fetch(endpoint, { headers: { Accept: 'application/json' } });
      if (!response.ok) return;
      const payload = (await response.json()) as { artistMetrics?: ArtistMetric[] };
      payload.artistMetrics?.forEach((metric) => {
        const slide = gallery.querySelector<HTMLElement>(
          `[data-artist-id="${CSS.escape(metric.artistId)}"]`,
        );
        if (!slide) return;
        (
          ['totalPlays', 'plays30d', 'soundcloudFollowers', 'spotifyMonthlyListeners'] as const
        ).forEach((key) => {
          const value = metric[key];
          const target = slide.querySelector<HTMLElement>(`[data-artist-metric="${key}"]`);
          if (target)
            target.textContent =
              value === null ? (key === 'plays30d' ? 'COLLECTING' : '—') : formatCount(value);
        });
      });
    } catch {
      // The checked-in snapshot remains visible when the Worker is unavailable.
    }
  };

  const setupArtists = () => {
    const openPanel = (slide: HTMLElement, requested: string) => {
      const buttons = [...slide.querySelectorAll<HTMLButtonElement>('[data-artist-panel-button]')];
      const panels = [...slide.querySelectorAll<HTMLElement>('[data-artist-panel]')];
      buttons.forEach((candidate) =>
        candidate.setAttribute(
          'aria-expanded',
          candidate.dataset.artistPanelButton === requested ? 'true' : 'false',
        ),
      );
      panels.forEach((panel) => {
        if (panel.dataset.artistPanel === requested) panel.dataset.open = 'true';
        else delete panel.dataset.open;
      });
      slide.dataset.panelOpen = requested;
    };

    document.querySelectorAll<HTMLElement>('.artist-slide').forEach((slide) => {
      const buttons = [...slide.querySelectorAll<HTMLButtonElement>('[data-artist-panel-button]')];
      openPanel(slide, 'info');
      buttons.forEach((button) => {
        button.addEventListener('click', () => {
          const requested = button.dataset.artistPanelButton;
          if (requested) openPanel(slide, requested);
        });
      });
    });

    document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
      gallery.addEventListener('lifesteal:gallery-slide-active', (event) => {
        const slide = (event as CustomEvent<{ slide?: HTMLElement }>).detail.slide;
        if (slide?.classList.contains('artist-slide')) openPanel(slide, 'info');
      });
      setupSnapGallery(gallery);
      void hydrateArtistMetrics(gallery);
    });
  };

  document.addEventListener('astro:page-load', setupArtists);
</script>

<style>
  .artist-gallery {
    display: flex;
    min-height: 0;
    overflow: hidden;
    flex: 1;
    flex-direction: column;
    border-color: color-mix(in srgb, var(--gallery-accent), transparent 58%);
    background: var(--gallery-background);
    box-shadow: 0 0 45px color-mix(in srgb, var(--gallery-glow), transparent 94%);
    transition:
      background-color 180ms linear,
      border-color 180ms linear,
      box-shadow 180ms linear;
  }

  .snap-gallery__viewport {
    display: flex;
    min-width: 0;
    min-height: 0;
    overflow-x: auto;
    overflow-y: hidden;
    flex: 1;
    scrollbar-color: var(--gallery-accent) color-mix(in srgb, var(--gallery-surface), #000 50%);
    scrollbar-width: thin;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
  }

  .snap-gallery__viewport::-webkit-scrollbar {
    height: 8px;
  }

  .snap-gallery__viewport::-webkit-scrollbar-track {
    background: color-mix(in srgb, var(--gallery-surface), #000 50%);
  }

  .snap-gallery__viewport::-webkit-scrollbar-thumb {
    border: 2px solid color-mix(in srgb, var(--gallery-surface), #000 50%);
    background: var(--gallery-accent);
  }

  .artist-slide {
    --accent: var(--artist-accent);
    display: grid;
    min-width: 100%;
    min-height: 0;
    grid-template-columns: minmax(280px, 0.9fr) minmax(390px, 1.1fr);
    overflow: hidden;
    background:
      radial-gradient(
        circle at 100% 0,
        color-mix(in srgb, var(--artist-accent), transparent 84%),
        transparent 48%
      ),
      var(--artist-background);
    color: var(--artist-foreground);
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  .artist-slide__image-wrap {
    position: relative;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    border-right: 1px solid color-mix(in srgb, var(--artist-accent), transparent 65%);
    background: var(--artist-surface);
  }

  .artist-slide__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: contrast(1.08) saturate(0.88);
  }

  .artist-slide__tint,
  .artist-slide__scan {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .artist-slide__tint {
    background: color-mix(in srgb, var(--artist-accent), transparent 82%);
    mix-blend-mode: color;
  }

  .artist-slide__scan {
    background: linear-gradient(
      105deg,
      transparent 28%,
      color-mix(in srgb, var(--artist-accent), transparent 84%) 38%,
      rgba(55, 234, 255, 0.14) 44%,
      rgba(255, 255, 255, 0.17) 48%,
      rgba(255, 59, 215, 0.14) 52%,
      rgba(255, 227, 110, 0.12) 56%,
      transparent 67%
    );
    background-size: 250% 100%;
    mix-blend-mode: screen;
    animation: artist-scan 9s linear infinite;
  }

  .artist-slide__copy {
    display: flex;
    min-width: 0;
    min-height: 0;
    padding: clamp(24px, 4.2vh, 58px) clamp(28px, 4.2vw, 66px);
    flex-direction: column;
    justify-content: center;
  }

  .artist-slide__image-wrap,
  .artist-slide__copy > * {
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 300ms ease,
      transform 420ms cubic-bezier(0.2, 0.72, 0.22, 1);
  }

  .artist-slide[data-gallery-visible='true'] .artist-slide__image-wrap,
  .artist-slide[data-gallery-visible='true'] .artist-slide__copy > * {
    opacity: var(--gallery-content-opacity, 1);
    transform: translateY(var(--gallery-content-shift, 0));
  }

  .artist-slide[data-gallery-visible='true'] .artist-slide__copy > :nth-child(2) {
    transition-delay: 55ms;
  }

  .artist-slide[data-gallery-visible='true'] .artist-slide__copy > :nth-child(3) {
    transition-delay: 100ms;
  }

  .artist-slide[data-gallery-visible='true'] .artist-slide__copy > :nth-child(n + 4) {
    transition-delay: 150ms;
  }

  .artist-slide .eyebrow,
  .artist-meta dt,
  .artist-slide :global(.button-link)::before {
    color: var(--artist-accent);
  }

  .artist-mobile-tabs button::before,
  .artist-mobile-tabs button::after {
    animation: accent-prism-glow 9s ease-in-out infinite;
  }

  .artist-meta {
    display: grid;
    width: 100%;
    margin: 0 0 clamp(14px, 2vh, 24px);
    gap: 6px;
  }

  .artist-stats {
    display: grid;
    padding: 0;
    margin: 0 0 clamp(12px, 1.8vh, 20px);
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border: 1px solid color-mix(in srgb, var(--artist-accent), transparent 68%);
    list-style: none;
  }

  .artist-stats li {
    display: grid;
    min-width: 0;
    padding: 9px 10px;
    background: color-mix(in srgb, var(--artist-accent), transparent 93%);
    gap: 2px;
  }

  .artist-stats li:not(:last-child) {
    border-right: 1px solid color-mix(in srgb, var(--artist-accent), transparent 75%);
  }

  .artist-stats span {
    color: color-mix(in srgb, var(--artist-foreground), transparent 48%);
    font-size: 7px;
    letter-spacing: 0.04em;
  }

  .artist-stats strong {
    overflow: hidden;
    color: var(--artist-accent);
    font-family: var(--display);
    font-size: clamp(17px, 2.5vh, 25px);
    font-weight: 800;
    text-overflow: ellipsis;
  }

  .artist-mobile-tabs {
    display: none;
  }

  .artist-meta div {
    display: grid;
    grid-template-columns: 84px 1fr;
    padding-bottom: 6px;
    border-bottom: 1px dotted color-mix(in srgb, var(--artist-accent), transparent 72%);
  }

  .artist-meta dt {
    font-size: 9px;
    letter-spacing: 0.08em;
  }

  .artist-meta dd {
    margin: 0;
    color: color-mix(in srgb, var(--artist-foreground), transparent 16%);
    font-size: 11px;
  }

  .artist-biography {
    max-width: 680px;
    margin-bottom: 0;
    color: color-mix(in srgb, var(--artist-foreground), transparent 22%);
    font-size: clamp(11px, 1.35vh, 14px);
    line-height: 1.55;
  }

  .artist-links {
    display: flex;
    padding: 0;
    margin: clamp(10px, 1.8vh, 18px) 0 0;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
  }

  .artist-links :global(.button-link) {
    min-height: 38px;
    padding: 7px 13px;
    border-color: color-mix(in srgb, var(--artist-accent), transparent 52%);
    background: color-mix(in srgb, var(--artist-surface), transparent 12%);
  }

  .snap-gallery__controls {
    display: grid;
    min-height: 44px;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    padding: 0 14px;
    border-top: 1px solid color-mix(in srgb, var(--gallery-accent), transparent 65%);
    background: color-mix(in srgb, var(--gallery-surface), #000 36%);
    color: color-mix(in srgb, var(--gallery-foreground), transparent 22%);
    font-size: 9px;
    letter-spacing: 0.09em;
    gap: 18px;
  }

  .snap-gallery__markers {
    display: flex;
    align-items: stretch;
    align-self: stretch;
  }

  .snap-gallery__markers button {
    min-width: 42px;
    border: 0;
    border-right: 1px solid color-mix(in srgb, var(--gallery-accent), transparent 78%);
    background: transparent;
    color: inherit;
    font-size: 9px;
    cursor: pointer;
  }

  .snap-gallery__markers button[aria-current='true'] {
    background: color-mix(in srgb, var(--gallery-accent), transparent 85%);
    color: var(--gallery-foreground);
    text-shadow: 0 0 8px var(--gallery-glow);
  }

  .snap-gallery__controls output {
    color: var(--gallery-foreground);
    text-shadow: 0 0 8px color-mix(in srgb, var(--gallery-glow), transparent 35%);
  }

  @keyframes artist-scan {
    to {
      background-position: -250% 0;
    }
  }

  @media (max-width: 900px) {
    :global(body[data-page='artists']) {
      height: 100svh;
      min-height: 100svh;
      overflow: hidden;
      overscroll-behavior: none;
    }

    :global(body[data-page='artists']:has(.site-footer__details[open])) {
      overflow-y: auto;
    }

    :global(body[data-page='artists'] .site-main) {
      height: calc(100svh - var(--header-height) - var(--mobile-footer-height));
      flex: 0 0 auto;
    }

    .artist-gallery {
      height: 100%;
      min-height: 0;
      flex: 1;
    }

    .artist-slide {
      grid-template-columns: 1fr;
      grid-template-rows: minmax(260px, 48%) minmax(0, 1fr);
      transition: grid-template-rows 360ms cubic-bezier(0.2, 0.72, 0.22, 1);
    }

    .artist-slide[data-panel-open] {
      grid-template-rows: minmax(190px, 30svh) minmax(0, 1fr);
    }

    .artist-slide__image-wrap {
      border-right: 0;
      border-bottom: 1px solid color-mix(in srgb, var(--artist-accent), transparent 65%);
    }

    .artist-slide__copy {
      justify-content: flex-start;
      padding: 24px 22px 30px;
      overflow: hidden;
    }

    .artist-mobile-tabs {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 8px;
    }

    .artist-mobile-tabs button {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 38px;
      padding: 8px 12px;
      border: 1px solid color-mix(in srgb, var(--artist-accent), transparent 50%);
      background: color-mix(in srgb, var(--artist-surface), transparent 12%);
      color: var(--artist-foreground);
      font-size: 10px;
      letter-spacing: 0.08em;
      cursor: pointer;
    }

    .artist-mobile-tabs button::before {
      color: var(--artist-accent);
      content: '>';
    }

    .artist-mobile-tabs button::after {
      color: var(--artist-accent);
      content: '[+]';
    }

    .artist-mobile-tabs button[aria-expanded='true'] {
      background: color-mix(in srgb, var(--artist-accent), transparent 84%);
      box-shadow: inset 0 0 18px color-mix(in srgb, var(--artist-glow), transparent 82%);
    }

    .artist-mobile-tabs button[aria-expanded='true']::after {
      content: '[-]';
    }

    .artist-slide__panel {
      max-height: 0;
      padding-top: 0;
      overflow: hidden;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-5px);
      transition:
        max-height 420ms cubic-bezier(0.2, 0.72, 0.22, 1),
        padding-top 260ms ease,
        opacity 220ms ease,
        transform 260ms ease,
        visibility 0s linear 420ms;
    }

    .artist-slide__panel[data-open='true'] {
      max-height: min(42svh, 390px);
      padding-top: 16px;
      padding-right: 6px;
      overflow-y: hidden;
      opacity: 1;
      overscroll-behavior: contain;
      scrollbar-color: var(--artist-accent) color-mix(in srgb, var(--artist-surface), #000 50%);
      scrollbar-width: thin;
      visibility: visible;
      transform: none;
      transition-delay: 0s;
    }

    .artist-meta {
      margin-bottom: 14px;
    }

    .artist-biography {
      margin-bottom: 0;
    }

    .artist-links {
      margin-top: 0;
    }

    .snap-gallery__hint {
      display: none;
    }

    .snap-gallery__controls {
      grid-template-columns: 1fr auto;
    }
  }

  @media (max-width: 540px) {
    .artist-stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin-bottom: 12px;
    }

    .artist-stats li:nth-child(2) {
      border-right: 0;
    }

    .artist-stats li:nth-child(-n + 2) {
      border-bottom: 1px solid color-mix(in srgb, var(--artist-accent), transparent 75%);
    }

    .artist-stats li {
      min-height: 54px;
      padding: 8px;
    }

    .artist-stats strong {
      font-size: 19px;
    }

    .artist-meta div {
      grid-template-columns: 72px 1fr;
    }
  }
</style>

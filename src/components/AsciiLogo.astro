---
import figlet from 'figlet';

const renderLogo = (text: string) =>
  figlet
    .textSync(text, {
      font: 'Small Slant',
      horizontalLayout: 'fitted',
      verticalLayout: 'fitted',
    })
    .trimEnd();
const smallLogoText = renderLogo('lifesteal');
const compactLogoText = renderLogo('lifesteal.world');
const wideLogoText = renderLogo('www.lifesteal.world');
const smallColumns = Math.max(...smallLogoText.split('\n').map((line) => line.length), 1);
---

<div class="ascii-stage" data-ascii-stage data-colour-mode="green">
  <canvas class="ascii-stage__canvas" data-rain-canvas aria-hidden="true"></canvas>
  <section class="ascii-snake" data-snake hidden tabindex="-1" aria-label="SNAKE terminal game">
    <div class="ascii-snake__register">
      <span>SNAKE.EXE</span>
      <span data-snake-score>SCORE 000</span>
    </div>
    <canvas data-snake-canvas width="600" height="360" aria-hidden="true"></canvas>
    <div class="ascii-snake__footer">
      <span data-snake-status aria-live="polite">ARROWS / WASD TO MOVE</span>
      <button type="button" data-snake-exit>ESC / EXIT</button>
    </div>
  </section>
  <div class="ascii-console">
    <pre
      class="ascii-logo"
      aria-hidden="true"
      data-ascii-logo
      data-typing="true"
      data-logo-variant="small"
      style={`--logo-columns:${smallColumns}`}><span class="ascii-logo__measure" data-ascii-source data-small={smallLogoText} data-compact={compactLogoText} data-wide={wideLogoText}>{smallLogoText}</span><span class="ascii-logo__output" data-ascii-output /><span class="ascii-logo__shimmer prism-text" data-ascii-shimmer /></pre>
    <form class="ascii-terminal" data-terminal-form autocomplete="off">
      <label class="visually-hidden" for="ascii-terminal-input"
        >Enter a colour or page command</label
      >
      <span class="ascii-terminal__prompt" aria-hidden="true">C:\lifesteal\system&gt;</span>
      <span class="ascii-terminal__entry">
        <span class="ascii-terminal__value" data-terminal-value aria-hidden="true"></span>
        <span class="ascii-terminal__cursor" aria-hidden="true"></span>
        <input
          id="ascii-terminal-input"
          class="ascii-terminal__input"
          data-terminal-input
          type="text"
          inputmode="text"
          maxlength="160"
          autocomplete="off"
          autocapitalize="characters"
          spellcheck="false"
          disabled
          aria-describedby="ascii-terminal-hint"
        />
      </span>
      <span id="ascii-terminal-hint" class="visually-hidden"
        >Enter one or more colour names, optionally prefixed with light or dark; or enter a page
        name, reset, or snake, then press Enter.</span
      >
    </form>
  </div>
  <span class="visually-hidden">lifesteal</span>
  <p class="ascii-stage__tagline">INDEPENDENT AUDIO // NAARM</p>
</div>

<script>
  import {
    applyStoredTheme,
    applyTheme,
    resetTheme,
    resolveThemeCommand,
    type ThemeMode,
  } from '../lib/theme';

  type RainOrigin = { x: number; y: number };
  type LogoInkLine = { baselineY: number; text: string; x: number };
  type RainStream = {
    ambient: boolean;
    colorOffset: number;
    glyphs: string[];
    headY: number;
    length: number;
    nextGlyphAt: number;
    spacing: number;
    speed: number;
    spawnY: number;
    x: number;
  };

  const setupAsciiLogo = () => {
    const stage = document.querySelector<HTMLElement>('[data-ascii-stage]');
    const logo = stage?.querySelector<HTMLElement>('[data-ascii-logo]');
    const source = stage?.querySelector<HTMLElement>('[data-ascii-source]');
    const output = stage?.querySelector<HTMLElement>('[data-ascii-output]');
    const shimmer = stage?.querySelector<HTMLElement>('[data-ascii-shimmer]');
    const canvas = stage?.querySelector<HTMLCanvasElement>('[data-rain-canvas]');
    const terminalForm = stage?.querySelector<HTMLFormElement>('[data-terminal-form]');
    const terminalInput = stage?.querySelector<HTMLInputElement>('[data-terminal-input]');
    const terminalValue = stage?.querySelector<HTMLElement>('[data-terminal-value]');
    const snakePanel = stage?.querySelector<HTMLElement>('[data-snake]');
    const snakeCanvas = stage?.querySelector<HTMLCanvasElement>('[data-snake-canvas]');
    const snakeScore = stage?.querySelector<HTMLElement>('[data-snake-score]');
    const snakeStatus = stage?.querySelector<HTMLElement>('[data-snake-status]');
    const snakeExit = stage?.querySelector<HTMLButtonElement>('[data-snake-exit]');

    if (stage && logo && source && output && shimmer && canvas) {
      const context = canvas.getContext('2d', { alpha: true });
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const desktopTerminal = window.matchMedia('(min-width: 901px)');
      const mobileViewport = window.matchMedia('(max-width: 700px)');
      const typingDuration = 5000;
      const typingTick = 72;
      const glyphs = [
        ...'0123456789',
        ...'!@#$%^&*+-=<>?/\\|[]{}:;~_',
        ...'アカサタナハマヤラワイキシチニヒミリヰウクスツヌフムユルヱエケセテネヘメレヲオコソトノホモヨロン',
        ...'あかさたなはまやらわいきしちにひみりうくすつぬふむゆるえけせてねへめれをおこそとのほもよろん',
        ...'ΑΒΓΔΕΖΗΘΙΚΛΜΝΞΟΠΡΣΤΥΦΧΨΩαβγδεζηθικλμνξοπρστυφχψω',
        ...'АБВГДЕЖЗИКЛМНОПРСТУФХЦЧШЩЭЮЯабвгдежзиклмнопрстуфхцчшщэюя',
        ...'אבגדהוזחטיכלמנסעפצקרשת',
        ...'ابتثجحخدذرزسشصضطظعغفقكلمنهوي',
        ...'가나다라마바사아자차카타파하',
        ...'अआइईउऊकखगघचछजझटठडढतथदधपफबभमयरलवशषसह',
      ];
      const smallText = source.dataset.small ?? source.textContent ?? '';
      const compactText = source.dataset.compact ?? smallText;
      const wideText = source.dataset.wide ?? compactText;
      let fullText = smallText;
      const origins: RainOrigin[] = [];
      const logoInkLines: LogoInkLine[] = [];
      const logoStreams: RainStream[] = [];
      const ambientStreams: RainStream[] = [];
      const coverageCanvas = document.createElement('canvas');
      const coverageContext = coverageCanvas.getContext('2d', { alpha: true });
      const routeBase = import.meta.env.BASE_URL.replace(/\/$/, '');
      const routeCommands: Record<string, string> = {
        HOME: '/',
        ARTIST: '/artists/',
        ARTISTS: '/artists/',
        RELEASE: '/releases/',
        RELEASES: '/releases/',
        RADIO: '/radio/',
        STORE: '/store/',
        ABOUT: '/about/',
      };
      let frame = 0;
      let lastTime = 0;
      let width = 0;
      let height = 0;
      let typingComplete = false;
      let typedCharacterCount = -1;
      let visible = true;
      let activeMode = applyStoredTheme();
      let logoMaskFont = '';
      let nextAmbientSpawnAt = performance.now() + 180 + Math.random() * 520;
      let nextLogoSpawnAt = Number.POSITIVE_INFINITY;
      let snakeTimer = 0;
      let snakeSegments: Array<{ x: number; y: number }> = [];
      let snakeDirection = { x: 1, y: 0 };
      let snakeNextDirection = { x: 1, y: 0 };
      let snakeFood = { x: 21, y: 9 };
      let snakeGameOver = false;
      let snakePaused = false;

      const randomGlyph = () => glyphs[Math.floor(Math.random() * glyphs.length)] ?? 'ア';

      const applyVisualMode = (mode: ThemeMode) => {
        activeMode = mode;
        stage.dataset.colourMode = mode.name;
        stage.style.setProperty('--terminal-primary', mode.accent);
      };

      const createGlyphTrail = (length: number) => Array.from({ length }, () => randomGlyph());

      const createLogoStream = (time: number): RainStream | undefined => {
        const origin = origins[Math.floor(Math.random() * origins.length)];
        if (!origin) return undefined;
        const length = 5 + Math.floor(Math.random() * 12);
        return {
          ambient: false,
          x: origin.x,
          headY: origin.y + 1,
          spawnY: origin.y + 1,
          speed: 42 + Math.pow(Math.random(), 0.7) * 112,
          spacing: 10 + Math.random() * 6,
          length,
          glyphs: createGlyphTrail(length),
          nextGlyphAt: time + 55 + Math.random() * 185,
          colorOffset: Math.floor(Math.random() * activeMode.rain.length),
        };
      };

      const createAmbientStream = (time: number): RainStream => {
        const grid = mobileViewport.matches ? 15 : 13;
        const length = 19 + Math.floor(Math.random() * 25);
        const spacing = 12 + Math.random() * 7;
        return {
          ambient: true,
          x: Math.round((Math.random() * width) / grid) * grid,
          headY: -spacing,
          spawnY: -spacing,
          speed: 9 + Math.pow(Math.random(), 0.72) * 31,
          spacing,
          length,
          glyphs: createGlyphTrail(length),
          nextGlyphAt: time + 100 + Math.random() * 360,
          colorOffset: Math.floor(Math.random() * activeMode.rain.length),
        };
      };

      const selectResponsiveLogo = () => {
        const useWide = stage.clientWidth >= 1180;
        const useCompact = stage.clientWidth >= 720;
        const nextText = useWide ? wideText : useCompact ? compactText : smallText;
        const variant = useWide ? 'wide' : useCompact ? 'compact' : 'small';
        if (nextText === fullText && logo.dataset.logoVariant === variant) return false;
        fullText = nextText;
        source.textContent = fullText;
        logo.dataset.logoVariant = variant;
        logo.style.setProperty(
          '--logo-columns',
          String(Math.max(...fullText.split('\n').map((line) => line.length), 1)),
        );
        output.textContent = typingComplete ? fullText : '';
        shimmer.textContent = output.textContent;
        typedCharacterCount = typingComplete ? fullText.length : -1;
        return true;
      };

      const scheduleRain = (time: number) => {
        if (time >= nextAmbientSpawnAt) {
          const ambientLimit = mobileViewport.matches ? 18 : 38;
          if (ambientStreams.length < ambientLimit) {
            ambientStreams.push(createAmbientStream(time));
          }
          nextAmbientSpawnAt = time + 170 + Math.random() * 760;
        }

        if (typingComplete && time >= nextLogoSpawnAt) {
          const logoLimit = mobileViewport.matches ? 16 : 32;
          if (logoStreams.length < logoLimit) {
            const stream = createLogoStream(time);
            if (stream) logoStreams.push(stream);
          }
          nextLogoSpawnAt = time + 105 + Math.random() * 620;
        }
      };

      const buildCoverageMask = (stageRect: DOMRect, logoRect: DOMRect, fontSize: number) => {
        if (!coverageContext || width <= 0 || height <= 0) return;
        coverageCanvas.width = Math.max(1, Math.ceil(width));
        coverageCanvas.height = Math.max(1, Math.ceil(height));
        coverageContext.clearRect(0, 0, coverageCanvas.width, coverageCanvas.height);
        coverageContext.fillStyle = '#fff';
        coverageContext.font = logoMaskFont;
        coverageContext.textAlign = 'left';
        coverageContext.textBaseline = 'alphabetic';
        for (const line of logoInkLines) {
          coverageContext.fillText(line.text, line.x, line.baselineY);
        }

        const padding = Math.max(3, Math.ceil(fontSize * 0.22));
        const left = Math.max(0, Math.floor(logoRect.left - stageRect.left - padding));
        const top = Math.max(0, Math.floor(logoRect.top - stageRect.top - padding));
        const right = Math.min(
          coverageCanvas.width,
          Math.ceil(logoRect.right - stageRect.left + padding),
        );
        const bottom = Math.min(
          coverageCanvas.height,
          Math.ceil(logoRect.bottom - stageRect.top + padding),
        );
        const maskWidth = Math.max(1, right - left);
        const maskHeight = Math.max(1, bottom - top);
        const image = coverageContext.getImageData(left, top, maskWidth, maskHeight);
        const size = maskWidth * maskHeight;
        const ink = new Uint8Array(size);
        for (let index = 0; index < size; index += 1) {
          if ((image.data[index * 4 + 3] ?? 0) > 20) ink[index] = 1;
        }

        const closedInk = ink.slice();
        const radius = fontSize >= 12 ? 2 : 1;
        for (let y = 0; y < maskHeight; y += 1) {
          for (let x = 0; x < maskWidth; x += 1) {
            const index = y * maskWidth + x;
            if (!ink[index]) continue;
            for (let offsetY = -radius; offsetY <= radius; offsetY += 1) {
              const nextY = y + offsetY;
              if (nextY < 0 || nextY >= maskHeight) continue;
              for (let offsetX = -radius; offsetX <= radius; offsetX += 1) {
                const nextX = x + offsetX;
                if (nextX < 0 || nextX >= maskWidth) continue;
                closedInk[nextY * maskWidth + nextX] = 1;
              }
            }
          }
        }

        const exterior = new Uint8Array(size);
        const queue = new Int32Array(size);
        let queueStart = 0;
        let queueEnd = 0;
        const enqueue = (index: number) => {
          if (index < 0 || index >= size || closedInk[index] || exterior[index]) return;
          exterior[index] = 1;
          queue[queueEnd++] = index;
        };
        for (let x = 0; x < maskWidth; x += 1) {
          enqueue(x);
          enqueue((maskHeight - 1) * maskWidth + x);
        }
        for (let y = 0; y < maskHeight; y += 1) {
          enqueue(y * maskWidth);
          enqueue(y * maskWidth + maskWidth - 1);
        }
        while (queueStart < queueEnd) {
          const index = queue[queueStart++] ?? 0;
          const x = index % maskWidth;
          const y = Math.floor(index / maskWidth);
          if (x > 0) enqueue(index - 1);
          if (x + 1 < maskWidth) enqueue(index + 1);
          if (y > 0) enqueue(index - maskWidth);
          if (y + 1 < maskHeight) enqueue(index + maskWidth);
        }

        for (let index = 0; index < size; index += 1) {
          const covered = closedInk[index] || !exterior[index];
          image.data[index * 4] = 255;
          image.data[index * 4 + 1] = 255;
          image.data[index * 4 + 2] = 255;
          image.data[index * 4 + 3] = covered ? 255 : 0;
        }
        coverageContext.clearRect(0, 0, coverageCanvas.width, coverageCanvas.height);
        coverageContext.putImageData(image, left, top);
      };

      const rebuildGeometry = () => {
        if (!context) return;
        selectResponsiveLogo();
        origins.length = 0;
        logoInkLines.length = 0;
        const stageRect = stage.getBoundingClientRect();
        const logoRect = logo.getBoundingClientRect();
        const style = getComputedStyle(logo);
        const fontSize = Number.parseFloat(style.fontSize);
        const lineHeight = Number.parseFloat(style.lineHeight) || fontSize * 1.1;
        logoMaskFont = `${style.fontWeight} ${fontSize}px ${style.fontFamily}`;
        context.font = logoMaskFont;
        const characterWidth = context.measureText('0').width;
        const lines = fullText.split('\n');
        const columns = Math.max(...lines.map((line) => line.length));
        const logoLeft = logoRect.left - stageRect.left;
        const logoTop = logoRect.top - stageRect.top;

        for (let row = 0; row < lines.length; row += 1) {
          const line = lines[row] ?? '';
          if (/\S/.test(line)) {
            const metrics = context.measureText(line);
            const ascent = metrics.actualBoundingBoxAscent || fontSize * 0.8;
            const descent = metrics.actualBoundingBoxDescent || fontSize * 0.2;
            logoInkLines.push({
              x: logoLeft,
              baselineY: logoTop + row * lineHeight + (lineHeight - ascent - descent) / 2 + ascent,
              text: line,
            });
          }
        }

        for (let column = 0; column < columns; column += 1) {
          let lastInkRow = -1;
          for (let row = 0; row < lines.length; row += 1) {
            if ((lines[row]?.[column] ?? ' ') !== ' ') lastInkRow = row;
          }
          if (lastInkRow >= 0) {
            origins.push({
              x: logoLeft + (column + 0.5) * characterWidth,
              y: logoTop + (lastInkRow + 0.92) * lineHeight,
            });
          }
        }

        buildCoverageMask(stageRect, logoRect, fontSize);

        for (let index = ambientStreams.length - 1; index >= 0; index -= 1) {
          if ((ambientStreams[index]?.x ?? 0) > width + 20) ambientStreams.splice(index, 1);
        }
        for (let index = logoStreams.length - 1; index >= 0; index -= 1) {
          if ((logoStreams[index]?.x ?? 0) > width + 20) logoStreams.splice(index, 1);
        }
      };

      const resize = () => {
        const stageRect = stage.getBoundingClientRect();
        const ratio = Math.min(window.devicePixelRatio || 1, mobileViewport.matches ? 1.2 : 1.4);
        width = stageRect.width;
        height = stageRect.height;
        canvas.width = Math.round(width * ratio);
        canvas.height = Math.round(height * ratio);
        canvas.style.width = `${width}px`;
        canvas.style.height = `${height}px`;
        context?.setTransform(ratio, 0, 0, ratio, 0, 0);
        rebuildGeometry();
      };

      const updateGlyphs = (stream: RainStream, time: number) => {
        if (time < stream.nextGlyphAt) return;
        for (let index = 0; index < stream.glyphs.length; index += 1) {
          if (Math.random() > 0.48) stream.glyphs[index] = randomGlyph();
        }
        stream.nextGlyphAt = time + (stream.ambient ? 150 : 70) + Math.random() * 180;
      };

      const drawStream = (stream: RainStream, time: number) => {
        if (
          !context ||
          stream.headY < 0 ||
          stream.headY - stream.length * stream.spacing > height
        ) {
          return false;
        }
        updateGlyphs(stream, time);
        context.font = '12px "IBM Plex Mono", monospace';
        context.textAlign = 'center';
        context.textBaseline = 'middle';
        let drewGlyph = false;

        const visibleTrail = stream.ambient
          ? stream.length - 1
          : Math.min(
              stream.length - 1,
              Math.floor((stream.headY - stream.spawnY) / stream.spacing),
            );
        for (let index = visibleTrail; index >= 0; index -= 1) {
          const y = stream.headY - index * stream.spacing;
          if (y < 0 || y > height + stream.spacing) continue;
          const strength = 1 - index / stream.length;
          const color =
            activeMode.rain[(stream.colorOffset + index) % activeMode.rain.length] ??
            activeMode.accent;
          context.save();
          context.globalAlpha = stream.ambient ? 0.18 + strength * 0.42 : 0.12 + strength * 0.76;
          context.fillStyle = color;
          if (stream.ambient && index === 0) {
            context.globalAlpha = 0.68;
            context.shadowBlur = 4;
            context.shadowColor = color;
          }
          if (!stream.ambient && index === 0) {
            context.globalAlpha = 0.96;
            context.shadowBlur = 10;
            context.shadowColor = color;
          }
          context.fillText(stream.glyphs[index] ?? randomGlyph(), stream.x, y);
          context.restore();
          drewGlyph = true;
        }
        return drewGlyph;
      };

      const maskLogoCoverage = () => {
        if (!context) return;
        context.save();
        context.globalCompositeOperation = 'destination-out';
        context.drawImage(coverageCanvas, 0, 0, width, height);
        context.restore();
      };

      const typeLogo = (time: number) => {
        if (typingComplete) return;
        const startedAt = Number(logo.dataset.typingStarted ?? time);
        logo.dataset.typingStarted = String(startedAt);
        const elapsed = Math.min(typingDuration, time - startedAt);
        const totalTicks = Math.ceil(typingDuration / typingTick);
        const completedTicks = Math.floor(elapsed / typingTick);
        const characterCount =
          elapsed >= typingDuration
            ? fullText.length
            : Math.min(
                fullText.length,
                Math.floor((completedTicks / totalTicks) * fullText.length),
              );
        if (characterCount !== typedCharacterCount) {
          typedCharacterCount = characterCount;
          output.textContent = fullText.slice(0, characterCount);
          shimmer.textContent = output.textContent;
        }
        if (characterCount >= fullText.length) {
          typingComplete = true;
          logo.dataset.typing = 'false';
          stage.dataset.terminalReady = 'true';
          window.dispatchEvent(new CustomEvent('lifesteal:prism-ready'));
          nextLogoSpawnAt = time + 160 + Math.random() * 420;
          if (desktopTerminal.matches && terminalInput) {
            terminalInput.disabled = false;
            window.setTimeout(() => terminalInput.focus({ preventScroll: true }), 120);
          }
        }
      };

      const draw = (time: number) => {
        if (!context || reducedMotion.matches) return;
        frame = requestAnimationFrame(draw);
        if (document.hidden || !visible) return;
        typeLogo(time);
        if (lastTime === 0) lastTime = time;
        const frameInterval = mobileViewport.matches ? 1000 / 24 : 1000 / 32;
        if (time - lastTime < frameInterval) return;
        const elapsed = Math.min((time - lastTime) / 1000, 0.065);
        lastTime = time;
        context.clearRect(0, 0, width, height);
        let drewRain = false;
        scheduleRain(time);

        for (let index = ambientStreams.length - 1; index >= 0; index -= 1) {
          const stream = ambientStreams[index];
          if (!stream) continue;
          stream.headY += stream.speed * elapsed;
          if (stream.headY - stream.length * stream.spacing > height + 20) {
            ambientStreams.splice(index, 1);
            continue;
          }
          drewRain = drawStream(stream, time) || drewRain;
        }

        if (typingComplete) {
          for (let index = logoStreams.length - 1; index >= 0; index -= 1) {
            const stream = logoStreams[index];
            if (!stream) continue;
            stream.headY += stream.speed * elapsed;
            if (stream.headY - stream.length * stream.spacing > height + 20) {
              logoStreams.splice(index, 1);
              continue;
            }
            drewRain = drawStream(stream, time) || drewRain;
          }
        }
        if (drewRain) maskLogoCoverage();
      };

      const updateTerminalValue = () => {
        if (terminalValue) terminalValue.textContent = terminalInput?.value.toUpperCase() ?? '';
      };

      const requestNavigation = (path: string) => {
        const href = `${routeBase}${path}` || '/';
        window.dispatchEvent(new CustomEvent('lifesteal:navigate', { detail: { href } }));
      };

      const snakeContext = snakeCanvas?.getContext('2d');
      const snakeColumns = 30;
      const snakeRows = 18;
      const snakeCell = 20;

      const placeSnakeFood = () => {
        do {
          snakeFood = {
            x: Math.floor(Math.random() * snakeColumns),
            y: Math.floor(Math.random() * snakeRows),
          };
        } while (
          snakeSegments.some((segment) => segment.x === snakeFood.x && segment.y === snakeFood.y)
        );
      };

      const drawSnake = () => {
        if (!snakeContext || !snakeCanvas) return;
        snakeContext.clearRect(0, 0, snakeCanvas.width, snakeCanvas.height);
        snakeContext.fillStyle = 'rgba(0, 0, 0, 0.9)';
        snakeContext.fillRect(0, 0, snakeCanvas.width, snakeCanvas.height);
        snakeContext.strokeStyle = activeMode.accent;
        snakeContext.globalAlpha = 0.1;
        snakeContext.lineWidth = 1;
        for (let x = snakeCell; x < snakeCanvas.width; x += snakeCell) {
          snakeContext.beginPath();
          snakeContext.moveTo(x, 0);
          snakeContext.lineTo(x, snakeCanvas.height);
          snakeContext.stroke();
        }
        for (let y = snakeCell; y < snakeCanvas.height; y += snakeCell) {
          snakeContext.beginPath();
          snakeContext.moveTo(0, y);
          snakeContext.lineTo(snakeCanvas.width, y);
          snakeContext.stroke();
        }
        snakeContext.globalAlpha = 1;
        snakeContext.fillStyle = activeMode.rain[1] ?? '#ffffff';
        snakeContext.shadowBlur = 15;
        snakeContext.shadowColor = activeMode.accent;
        snakeContext.fillRect(
          snakeFood.x * snakeCell + 5,
          snakeFood.y * snakeCell + 5,
          snakeCell - 10,
          snakeCell - 10,
        );
        snakeSegments.forEach((segment, index) => {
          snakeContext.fillStyle =
            activeMode.rain[index % activeMode.rain.length] ?? activeMode.accent;
          snakeContext.globalAlpha = Math.max(
            0.42,
            1 - index / Math.max(8, snakeSegments.length * 1.3),
          );
          snakeContext.shadowBlur = index === 0 ? 14 : 4;
          snakeContext.fillRect(
            segment.x * snakeCell + 2,
            segment.y * snakeCell + 2,
            snakeCell - 4,
            snakeCell - 4,
          );
        });
        snakeContext.globalAlpha = 1;
        snakeContext.shadowBlur = 0;
      };

      const resetSnakeBoard = () => {
        snakeSegments = [
          { x: 15, y: 9 },
          { x: 14, y: 9 },
          { x: 13, y: 9 },
          { x: 12, y: 9 },
        ];
        snakeDirection = { x: 1, y: 0 };
        snakeNextDirection = { x: 1, y: 0 };
        snakeGameOver = false;
        snakePaused = false;
        placeSnakeFood();
        if (snakeScore) snakeScore.textContent = 'SCORE 000';
        if (snakeStatus) snakeStatus.textContent = 'ARROWS / WASD TO MOVE';
        drawSnake();
      };

      const snakeTick = () => {
        if (snakePaused || snakeGameOver || snakeSegments.length === 0) return;
        snakeDirection = snakeNextDirection;
        const head = snakeSegments[0]!;
        const next = {
          x: (head.x + snakeDirection.x + snakeColumns) % snakeColumns,
          y: (head.y + snakeDirection.y + snakeRows) % snakeRows,
        };
        if (snakeSegments.some((segment) => segment.x === next.x && segment.y === next.y)) {
          snakeGameOver = true;
          if (snakeStatus) snakeStatus.textContent = 'SIGNAL LOST // ENTER TO RESTART';
          drawSnake();
          return;
        }
        snakeSegments.unshift(next);
        if (next.x === snakeFood.x && next.y === snakeFood.y) {
          placeSnakeFood();
        } else {
          snakeSegments.pop();
        }
        if (snakeScore) {
          snakeScore.textContent = `SCORE ${String((snakeSegments.length - 4) * 10).padStart(3, '0')}`;
        }
        drawSnake();
      };

      const stopSnake = () => {
        window.clearInterval(snakeTimer);
        snakeTimer = 0;
        if (snakePanel) snakePanel.hidden = true;
        delete stage.dataset.snakeActive;
        terminalInput?.focus({ preventScroll: true });
      };

      const startSnake = () => {
        if (!snakePanel || !snakeCanvas) return;
        window.clearInterval(snakeTimer);
        stage.dataset.snakeActive = 'true';
        snakePanel.hidden = false;
        resetSnakeBoard();
        snakeTimer = window.setInterval(snakeTick, 105);
        snakePanel.focus({ preventScroll: true });
      };

      const handleSnakeKey = (event: KeyboardEvent) => {
        if (stage.dataset.snakeActive !== 'true') return;
        const directions: Record<string, { x: number; y: number }> = {
          ArrowUp: { x: 0, y: -1 },
          w: { x: 0, y: -1 },
          ArrowDown: { x: 0, y: 1 },
          s: { x: 0, y: 1 },
          ArrowLeft: { x: -1, y: 0 },
          a: { x: -1, y: 0 },
          ArrowRight: { x: 1, y: 0 },
          d: { x: 1, y: 0 },
        };
        if (event.key === 'Escape') {
          event.preventDefault();
          stopSnake();
          return;
        }
        if (event.key === 'Enter' && snakeGameOver) {
          event.preventDefault();
          resetSnakeBoard();
          return;
        }
        if (event.key === ' ') {
          event.preventDefault();
          snakePaused = !snakePaused;
          if (snakeStatus)
            snakeStatus.textContent = snakePaused
              ? 'PAUSED // SPACE TO RESUME'
              : 'ARROWS / WASD TO MOVE';
          return;
        }
        const direction = directions[event.key] ?? directions[event.key.toLowerCase()];
        if (!direction) return;
        event.preventDefault();
        if (direction.x !== -snakeDirection.x || direction.y !== -snakeDirection.y) {
          snakeNextDirection = direction;
        }
      };

      document.addEventListener('keydown', handleSnakeKey);
      snakeExit?.addEventListener('click', stopSnake);

      terminalForm?.addEventListener('submit', (event) => {
        event.preventDefault();
        if (!terminalInput) return;
        const submitted = terminalInput.value.trim().toUpperCase();
        const mode = resolveThemeCommand(submitted);
        const route = routeCommands[submitted];
        if (submitted === 'RESET') {
          applyVisualMode(resetTheme());
        } else if (submitted === 'SNAKE') {
          startSnake();
        } else if (mode) {
          applyVisualMode(mode);
          applyTheme(mode);
        } else if (route) requestNavigation(route);
        terminalInput.value = '';
        updateTerminalValue();
      });
      for (const eventName of ['input', 'keyup', 'click', 'select']) {
        terminalInput?.addEventListener(eventName, updateTerminalValue);
      }
      stage.addEventListener('pointerdown', (event) => {
        if (
          desktopTerminal.matches &&
          stage.dataset.terminalReady === 'true' &&
          stage.dataset.snakeActive !== 'true' &&
          !(event.target instanceof HTMLAnchorElement)
        ) {
          if (event.target !== terminalInput) event.preventDefault();
          terminalInput?.focus({ preventScroll: true });
        }
      });

      const handleTheme = (event: Event) => {
        const mode = (event as CustomEvent<ThemeMode>).detail;
        if (mode) {
          applyVisualMode(mode);
          if (stage.dataset.snakeActive === 'true') drawSnake();
        }
      };
      window.addEventListener('lifesteal:theme', handleTheme);
      applyVisualMode(activeMode);

      if (reducedMotion.matches) {
        output.textContent = fullText;
        shimmer.textContent = fullText;
        logo.dataset.typing = 'false';
        typingComplete = true;
        stage.dataset.terminalReady = 'true';
        window.dispatchEvent(new CustomEvent('lifesteal:prism-ready'));
        if (desktopTerminal.matches && terminalInput) terminalInput.disabled = false;
      }

      resize();
      document.fonts?.ready.then(resize);
      const resizeObserver = new ResizeObserver(resize);
      const visibilityObserver = new IntersectionObserver(
        ([entry]) => {
          visible = entry?.isIntersecting ?? true;
        },
        { threshold: 0.05 },
      );
      resizeObserver.observe(stage);
      visibilityObserver.observe(stage);
      if (!reducedMotion.matches) frame = requestAnimationFrame(draw);

      document.addEventListener(
        'astro:before-swap',
        () => {
          cancelAnimationFrame(frame);
          window.clearInterval(snakeTimer);
          resizeObserver.disconnect();
          visibilityObserver.disconnect();
          window.removeEventListener('lifesteal:theme', handleTheme);
          document.removeEventListener('keydown', handleSnakeKey);
        },
        { once: true },
      );
    }
  };

  document.addEventListener('astro:page-load', setupAsciiLogo);
</script>

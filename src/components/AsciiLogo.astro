---
const logoText = String.raw`    ___ ____          __             __
   / (_) __/__  _____/ /____  ____ _/ /
  / / / /_/ _ \/ ___/ __/ _ \/ __ '/ /
 / / / __/  __(__  ) /_/  __/ /_/ / /
/_/_/_/  \___/____/\__/\___/\__,_/_/`;
---

<div class="ascii-stage" data-ascii-stage data-colour-mode="default">
  <div class="ascii-stage__status" aria-hidden="true">
    <span>LIFESTEAL // HOME</span>
    <span>FOUNDED 2021</span>
  </div>
  <canvas class="ascii-stage__canvas" data-drip-canvas aria-hidden="true"></canvas>
  <div class="ascii-console">
    <pre
      class="ascii-logo"
      aria-hidden="true"
      data-ascii-logo
      data-typing="true"><span class="ascii-logo__measure" data-ascii-source>{logoText}</span><span class="ascii-logo__output" data-ascii-output /><span class="ascii-logo__shimmer prism-text" data-ascii-shimmer /></pre>
    <form class="ascii-terminal" data-terminal-form autocomplete="off">
      <label class="visually-hidden" for="ascii-terminal-input">Enter a colour command</label>
      <span class="ascii-terminal__prompt" aria-hidden="true">C:\LIFESTEAL&gt;</span>
      <span class="ascii-terminal__entry">
        <input
          id="ascii-terminal-input"
          class="ascii-terminal__input"
          data-terminal-input
          type="text"
          inputmode="text"
          maxlength="24"
          autocomplete="off"
          autocapitalize="characters"
          spellcheck="false"
          disabled
          aria-describedby="ascii-terminal-hint"
        />
        <span class="ascii-terminal__cursor" data-terminal-cursor aria-hidden="true"></span>
      </span>
      <span id="ascii-terminal-hint" class="visually-hidden"
        >Enter a colour name and press Enter to recolour the logo.</span
      >
    </form>
  </div>
  <span class="visually-hidden">lifesteal</span>
  <p class="ascii-stage__tagline">INDEPENDENT AUDIO // NAARM</p>
</div>

<script>
  type Particle = {
    x: number;
    y: number;
    velocity: number;
    gravity: number;
    drift: number;
    alpha: number;
    life: number;
    age: number;
    glyph: string;
    color: string;
    size: number;
    rotation: number;
    angularVelocity: number;
  };

  type Origin = { x: number; y: number };

  const stage = document.querySelector<HTMLElement>('[data-ascii-stage]');
  const logo = stage?.querySelector<HTMLElement>('[data-ascii-logo]');
  const source = stage?.querySelector<HTMLElement>('[data-ascii-source]');
  const output = stage?.querySelector<HTMLElement>('[data-ascii-output]');
  const shimmer = stage?.querySelector<HTMLElement>('[data-ascii-shimmer]');
  const canvas = stage?.querySelector<HTMLCanvasElement>('[data-drip-canvas]');
  const terminalForm = stage?.querySelector<HTMLFormElement>('[data-terminal-form]');
  const terminalInput = stage?.querySelector<HTMLInputElement>('[data-terminal-input]');

  if (stage && logo && source && output && shimmer && canvas) {
    const context = canvas.getContext('2d', { alpha: true });
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const desktopTerminal = window.matchMedia('(min-width: 901px)');
    const typingDuration = 5000;
    type ColourMode = {
      name: string;
      logo: string[];
      particles: string[];
    };
    const colourModes: Record<string, ColourMode> = {
      DEFAULT: { name: 'default', logo: ['#f7f7f5'], particles: ['#ff304f'] },
      WHITE: { name: 'white', logo: ['#ffffff'], particles: ['#ffffff'] },
      RED: { name: 'red', logo: ['#ff304f'], particles: ['#ff304f', '#ff6b7f'] },
      BLUE: { name: 'blue', logo: ['#2f7cff'], particles: ['#2f7cff', '#72d7ff'] },
      GREEN: { name: 'green', logo: ['#2de37b'], particles: ['#2de37b', '#a4ffbf'] },
      PINK: { name: 'pink', logo: ['#ff4fa7'], particles: ['#ff4fa7', '#ff9bd0'] },
      PURPLE: { name: 'purple', logo: ['#a855f7'], particles: ['#a855f7', '#d7a6ff'] },
      ORANGE: { name: 'orange', logo: ['#ff7a1a'], particles: ['#ff7a1a', '#ffc067'] },
      YELLOW: { name: 'yellow', logo: ['#ffd400'], particles: ['#ffd400', '#fff09a'] },
      CYAN: { name: 'cyan', logo: ['#24d8ff'], particles: ['#24d8ff', '#b6f6ff'] },
      MAGENTA: { name: 'magenta', logo: ['#ff2ed1'], particles: ['#ff2ed1', '#ff9aea'] },
      GAY: {
        name: 'gay',
        logo: ['#078d70', '#26ceaa', '#98e8c1', '#ffffff', '#7bade2', '#5049cc', '#3d1a78'],
        particles: ['#078d70', '#26ceaa', '#98e8c1', '#ffffff', '#7bade2', '#5049cc', '#3d1a78'],
      },
      LESBIAN: {
        name: 'lesbian',
        logo: ['#d52d00', '#ff9a56', '#ffffff', '#d362a4', '#a30262'],
        particles: ['#d52d00', '#ff9a56', '#ffffff', '#d362a4', '#a30262'],
      },
      PAN: {
        name: 'pansexual',
        logo: ['#ff218c', '#ffd800', '#21b1ff'],
        particles: ['#ff218c', '#ffd800', '#21b1ff'],
      },
      BI: {
        name: 'bisexual',
        logo: ['#d60270', '#9b4f96', '#0038a8'],
        particles: ['#d60270', '#9b4f96', '#0038a8'],
      },
      TRANS: {
        name: 'transgender',
        logo: ['#5bcefa', '#f5a9b8', '#ffffff', '#f5a9b8', '#5bcefa'],
        particles: ['#5bcefa', '#f5a9b8', '#ffffff'],
      },
      INTERSEX: {
        name: 'intersex',
        logo: ['#ffd800', '#7902aa', '#ffd800'],
        particles: ['#ffd800', '#7902aa'],
      },
      RAINBOW: {
        name: 'rainbow',
        logo: ['#e40303', '#ff8c00', '#ffed00', '#008026', '#24408e', '#732982'],
        particles: ['#e40303', '#ff8c00', '#ffed00', '#008026', '#24408e', '#732982'],
      },
      ABORIGINAL: {
        name: 'aboriginal',
        logo: ['#000000', '#dd0000', '#ffcf00'],
        particles: ['#000000', '#dd0000', '#ffcf00'],
      },
    };
    const commandAliases: Record<string, string> = {
      PANSEXUAL: 'PAN',
      BISEXUAL: 'BI',
      TRANSGENDER: 'TRANS',
      LGBT: 'RAINBOW',
      INDIGENOUS: 'ABORIGINAL',
      GREY: 'WHITE',
      GRAY: 'WHITE',
    };
    const glyphs = [
      'ア',
      'イ',
      'ウ',
      'エ',
      'オ',
      'カ',
      'キ',
      'ク',
      'ケ',
      'コ',
      'サ',
      'シ',
      'ス',
      'セ',
      'ソ',
      'タ',
      'チ',
      'ツ',
      'テ',
      'ト',
      'ナ',
      'ニ',
      'ヌ',
      'ネ',
      'ノ',
      'ハ',
      'ヒ',
      'フ',
      'ヘ',
      'ホ',
      'マ',
      'ミ',
      'ム',
      'メ',
      'モ',
      'ヤ',
      'ユ',
      'ヨ',
      'ラ',
      'リ',
      'ル',
      'レ',
      'ロ',
      'ワ',
      'ヲ',
      'ン',
      'あ',
      'い',
      'う',
      'え',
      'お',
      'か',
      'き',
      'く',
      'け',
      'こ',
      'さ',
      'し',
      'す',
      'せ',
      'そ',
      'た',
      'ち',
      'つ',
      'て',
      'と',
      'な',
      'に',
      'ぬ',
      'ね',
      'の',
      'は',
      'ひ',
      'ふ',
      'へ',
      'ほ',
      'ま',
      'み',
      'む',
      'め',
      'も',
      'や',
      'ゆ',
      'よ',
      'ら',
      'り',
      'る',
      'れ',
      'ろ',
      'わ',
      'を',
      'ん',
      '/',
      '\\',
      '|',
      ':',
      '.',
      '1',
      '0',
      '+',
      '*',
    ];
    const fullText = source.textContent ?? '';
    const particles: Particle[] = [];
    const pool: Particle[] = [];
    const origins: Origin[] = [];
    let frame = 0;
    let lastTime = 0;
    let nextSpawnAt = Number.POSITIVE_INFINITY;
    let width = 0;
    let height = 0;
    let typingComplete = false;
    let visible = true;
    let activeMode = colourModes.DEFAULT;

    const makeGradient = (colors: string[]) => {
      if (colors.length === 1) return `linear-gradient(90deg, ${colors[0]}, ${colors[0]})`;
      return `linear-gradient(90deg, ${colors
        .map((color, index) => `${color} ${(index / (colors.length - 1)) * 100}%`)
        .join(', ')})`;
    };

    const applyColourMode = (mode: ColourMode) => {
      activeMode = mode;
      stage.dataset.colourMode = mode.name;
      stage.style.setProperty('--terminal-primary', mode.particles[0] ?? '#ff304f');
      stage.style.setProperty('--terminal-gradient', makeGradient(mode.logo));
    };

    const updateTerminalCursor = () => {
      if (!terminalInput) return;
      const position = terminalInput.selectionStart ?? terminalInput.value.length;
      terminalInput.parentElement?.style.setProperty('--cursor-position', String(position));
    };

    const revealTerminal = () => {
      stage.dataset.terminalReady = 'true';
      if (desktopTerminal.matches && terminalInput) {
        terminalInput.disabled = false;
        window.setTimeout(() => terminalInput.focus({ preventScroll: true }), 120);
      }
    };

    const rebuildOrigins = () => {
      if (!context) return;
      origins.length = 0;
      const stageRect = stage.getBoundingClientRect();
      const logoRect = logo.getBoundingClientRect();
      const style = getComputedStyle(logo);
      const fontSize = Number.parseFloat(style.fontSize);
      const lineHeight = Number.parseFloat(style.lineHeight) || fontSize * 1.1;
      context.font = `${style.fontWeight} ${fontSize}px ${style.fontFamily}`;
      const characterWidth = context.measureText('0').width;
      const lines = fullText.split('\n');
      const columns = Math.max(...lines.map((line) => line.length));
      const logoLeft = logoRect.left - stageRect.left;
      const logoTop = logoRect.top - stageRect.top;

      for (let column = 0; column < columns; column += 1) {
        let lastInkRow = -1;
        for (let row = 0; row < lines.length; row += 1) {
          if ((lines[row]?.[column] ?? ' ') !== ' ') lastInkRow = row;
        }
        if (lastInkRow >= 0) {
          origins.push({
            x: logoLeft + (column + 0.5) * characterWidth,
            y: logoTop + (lastInkRow + 0.91) * lineHeight,
          });
        }
      }
    };

    const resize = () => {
      const stageRect = stage.getBoundingClientRect();
      const ratio = Math.min(window.devicePixelRatio || 1, 1.5);
      width = stageRect.width;
      height = stageRect.height;
      canvas.width = Math.round(width * ratio);
      canvas.height = Math.round(height * ratio);
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      context?.setTransform(ratio, 0, 0, ratio, 0, 0);
      rebuildOrigins();
    };

    const createParticle = (time: number) => {
      if (particles.length >= 180 || origins.length === 0) return;
      const origin = origins[Math.floor(Math.random() * origins.length)];
      if (!origin) return;
      const particle = pool.pop() ?? ({} as Particle);
      Object.assign(particle, {
        x: origin.x + (Math.random() - 0.5) * 3,
        y: origin.y + Math.random() * 2,
        velocity: 17 + Math.random() * 36,
        gravity: 4 + Math.random() * 15,
        drift: (Math.random() - 0.5) * 7,
        alpha: 0.3 + Math.random() * 0.64,
        life: 2.8 + Math.random() * 3.8,
        age: 0,
        glyph: glyphs[Math.floor(Math.random() * glyphs.length)],
        color:
          activeMode.particles[Math.floor(Math.random() * activeMode.particles.length)] ??
          '#ff304f',
        size: 8 + Math.floor(Math.random() * 8),
        rotation: 0,
        angularVelocity: (Math.random() < 0.5 ? -1 : 1) * (1.25 + Math.random() * 2.75),
      });
      particles.push(particle);
      nextSpawnAt = time + 38 + Math.random() * 155;
    };

    const typeLogo = (time: number) => {
      if (typingComplete) return;
      const startedAt = Number(logo.dataset.typingStarted ?? time);
      logo.dataset.typingStarted = String(startedAt);
      const characterCount = Math.min(
        fullText.length,
        Math.floor(((time - startedAt) / typingDuration) * fullText.length),
      );
      output.textContent = fullText.slice(0, characterCount);
      shimmer.textContent = output.textContent;
      if (characterCount >= fullText.length) {
        typingComplete = true;
        logo.dataset.typing = 'false';
        nextSpawnAt = time + 180;
        revealTerminal();
      }
    };

    const draw = (time: number) => {
      frame = requestAnimationFrame(draw);
      if (!context || reducedMotion.matches || document.hidden || !visible) return;
      typeLogo(time);
      if (lastTime === 0) lastTime = time;
      const elapsed = Math.min((time - lastTime) / 1000, 0.05);
      if (elapsed < 1 / 45) return;
      lastTime = time;
      context.clearRect(0, 0, width, height);

      if (typingComplete && time >= nextSpawnAt) {
        createParticle(time);
        if (Math.random() > 0.74) createParticle(time);
      }

      for (let index = particles.length - 1; index >= 0; index -= 1) {
        const particle = particles[index];
        particle.age += elapsed;
        particle.velocity += particle.gravity * elapsed;
        particle.y += particle.velocity * elapsed;
        particle.x += particle.drift * elapsed;
        particle.rotation += particle.angularVelocity * elapsed;
        const opacity = particle.alpha * Math.max(0, 1 - particle.age / particle.life);
        context.save();
        context.translate(particle.x, particle.y);
        context.rotate(particle.rotation);
        context.font = `${particle.size}px "IBM Plex Mono", monospace`;
        context.globalAlpha = opacity;
        context.fillStyle = particle.color;
        context.shadowBlur = 7;
        context.shadowColor = particle.color;
        context.fillText(particle.glyph, 0, 0);
        context.restore();
        if (particle.y > height + 20 || particle.age >= particle.life) {
          particles.splice(index, 1);
          pool.push(particle);
        }
      }
    };

    if (reducedMotion.matches) {
      output.textContent = fullText;
      shimmer.textContent = fullText;
      logo.dataset.typing = 'false';
      typingComplete = true;
      revealTerminal();
    }

    applyColourMode(activeMode);

    terminalForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!terminalInput) return;
      const submitted = terminalInput.value.trim().toUpperCase();
      const command = commandAliases[submitted] ?? submitted;
      const mode = colourModes[command];
      if (mode) applyColourMode(mode);
      terminalInput.value = '';
      updateTerminalCursor();
    });
    for (const eventName of ['input', 'keyup', 'click', 'select']) {
      terminalInput?.addEventListener(eventName, updateTerminalCursor);
    }
    stage.addEventListener('pointerdown', (event) => {
      if (
        desktopTerminal.matches &&
        stage.dataset.terminalReady === 'true' &&
        !(event.target instanceof HTMLAnchorElement)
      ) {
        terminalInput?.focus({ preventScroll: true });
      }
    });

    resize();
    document.fonts?.ready.then(resize);
    const resizeObserver = new ResizeObserver(resize);
    const visibilityObserver = new IntersectionObserver(
      ([entry]) => {
        visible = entry?.isIntersecting ?? true;
      },
      { threshold: 0.05 },
    );
    resizeObserver.observe(stage);
    visibilityObserver.observe(stage);
    frame = requestAnimationFrame(draw);

    document.addEventListener('astro:before-swap', () => {
      cancelAnimationFrame(frame);
      resizeObserver.disconnect();
      visibilityObserver.disconnect();
    });
  }
</script>

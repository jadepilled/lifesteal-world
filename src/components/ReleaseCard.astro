---
import type { GeneratedRelease } from '../lib/schema';
import { releaseArtists } from '../lib/content';
import { withBase } from '../lib/base';
import AsciiTitle from './AsciiTitle.astro';
import { formatCount } from '../lib/format';

interface Props {
  release: GeneratedRelease;
  index: number;
}

const { release, index } = Astro.props;
const creditedArtists = releaseArtists(release.artistIds);
const spotifyLink = release.links.find((link) => link.platform === 'spotify');
const artworkSourceLink = release.links.find((link) => link.platform === release.artwork.source);
const artworkDestination = artworkSourceLink?.url ?? spotifyLink?.url ?? release.links[0]?.url;
const artworkPlatform =
  artworkSourceLink?.platform ?? spotifyLink?.platform ?? release.links[0]?.platform;
const artworkSrc = withBase(release.artwork.src);
const responsiveArtwork =
  release.artwork.src.startsWith('/assets/releases/') && release.artwork.src.endsWith('.webp')
    ? `${withBase(release.artwork.src.replace('.webp', '-540.webp'))} 540w, ${withBase(release.artwork.src.replace('.webp', '-800.webp'))} 800w, ${artworkSrc} 1080w`
    : undefined;
const dateLabel = release.releaseDate
  ? new Intl.DateTimeFormat('en-AU', { day: '2-digit', month: 'short', year: 'numeric' })
      .format(new Date(`${release.releaseDate}T00:00:00`))
      .toUpperCase()
  : 'DATE TBA';
const paletteStyle = [
  `--release-bg:${release.palette.background}`,
  `--release-surface:${release.palette.surface}`,
  `--release-fg:${release.palette.foreground}`,
  `--release-accent:${release.palette.accent}`,
  `--release-glow:${release.palette.glow}`,
].join(';');
const playMetrics = release.metrics.filter((metric) => metric.kind === 'plays');
const totalPlays = playMetrics.reduce((sum, metric) => sum + metric.value, 0);
const latestPlayDate = playMetrics
  .map((metric) => metric.asOf)
  .sort()
  .at(-1);
const hasSpotify = release.links.some((link) => link.platform === 'spotify');
const soundCloudOnly =
  !hasSpotify && playMetrics.length === 1 && playMetrics[0]?.platform === 'soundcloud';
---

<article
  class="release-card accent-prism-frame"
  style={paletteStyle}
  data-release-id={release.canonicalId}
  data-release-focus="artwork"
  data-has-spotify={hasSpotify ? 'true' : 'false'}
>
  <div class="release-card__artwork-shell" data-release-panel="artwork">
    <div class="release-card__focus-label accent-prism-text" aria-hidden="true">
      <span>01 / ARTWORK</span><span>SWIPE UP FOR RELEASE INFO</span>
    </div>
    {
      artworkDestination ? (
        <a
          href={artworkDestination}
          target="_blank"
          rel="noreferrer"
          aria-label={`Open ${release.title} on ${artworkPlatform ?? 'its release platform'}`}
        >
          <img
            class="release-card__artwork"
            src={artworkSrc}
            srcset={responsiveArtwork}
            sizes="(max-width: 760px) calc(100vw - 32px), 50vw"
            alt={release.artwork.alt}
            width="1080"
            height="1080"
            loading={index === 0 ? 'eager' : 'lazy'}
            fetchpriority={index === 0 ? 'high' : 'auto'}
          />
        </a>
      ) : (
        <img
          class="release-card__artwork"
          src={artworkSrc}
          srcset={responsiveArtwork}
          sizes="(max-width: 760px) calc(100vw - 32px), 50vw"
          alt={release.artwork.alt}
          width="1080"
          height="1080"
          loading={index === 0 ? 'eager' : 'lazy'}
          fetchpriority={index === 0 ? 'high' : 'auto'}
        />
      )
    }
  </div>

  <div class="release-card__copy" data-release-panel="info">
    <div class="release-card__focus-label accent-prism-text" aria-hidden="true">
      <span>02 / RELEASE INFO</span><span>SWIPE DOWN FOR ARTWORK</span>
    </div>
    <div class="release-card__register">
      <span>REL/{String(index + 1).padStart(3, '0')}</span>
      <span class="release-card__status accent-prism-text">[{release.status.toUpperCase()}]</span>
    </div>
    <p class="release-card__artist accent-prism-text">
      {creditedArtists.map((artist) => artist.displayName).join(' + ')}
    </p>
    <AsciiTitle text={release.title} accent="var(--release-accent)" />
    {release.version && <p class="release-card__version">{release.version}</p>}
    <ul class="release-card__genres" aria-label={`${release.title} genres`}>
      {release.genres.map((genre) => <li class="accent-prism-frame">{genre}</li>)}
    </ul>
    <dl class="release-card__meta accent-prism-frame">
      <div>
        <dt>FORMAT</dt>
        <dd>{release.releaseType.toUpperCase()}</dd>
      </div>
      <div>
        <dt>DATE</dt>
        <dd>{dateLabel}</dd>
      </div>
    </dl>
    <p class="release-card__biography">{release.biography}</p>

    <ul
      class="release-card__metrics"
      aria-label="Platform metrics"
      data-release-metrics
      hidden={release.metrics.length === 0}
    >
      <li class="accent-prism-frame" data-total-metric hidden={playMetrics.length === 0}>
        <span>TOTAL PLAYS</span>
        <strong data-total-metric-value>{formatCount(totalPlays)}</strong>
        <small data-total-metric-date>
          {latestPlayDate ? `AS OF ${new Date(latestPlayDate).toLocaleDateString('en-AU')}` : ''}
        </small>
      </li>
      {
        release.metrics.map((metric) => (
          <li
            class="accent-prism-frame"
            data-platform-metric
            data-platform={metric.platform}
            data-kind={metric.kind}
            hidden={soundCloudOnly && metric.platform === 'soundcloud' && metric.kind === 'plays'}
          >
            <span data-metric-label>{metric.platform.toUpperCase()} PLAYS</span>
            <strong class="accent-prism-text" data-metric-value>
              {metric.kind === 'plays' ? formatCount(metric.value) : `${metric.value}/100`}
            </strong>
            <small data-metric-date>
              AS OF {new Date(metric.asOf).toLocaleDateString('en-AU')}
            </small>
          </li>
        ))
      }
    </ul>

    <ul class="release-card__links" aria-label={`${release.title} platform links`}>
      {
        release.links.map((link) => (
          <li>
            <a
              class="button-link accent-prism-frame"
              href={link.url}
              target="_blank"
              rel="noreferrer"
            >
              {link.platform}
            </a>
          </li>
        ))
      }
      {release.links.length === 0 && <li class="release-card__pending">PLATFORM LINKS PENDING</li>}
    </ul>

    {
      ['spotify', 'soundcloud'].includes(release.artwork.source) && artworkSourceLink && (
        <p class="release-card__attribution">
          Artwork and metadata supplied by{' '}
          {release.artwork.source === 'spotify' ? 'Spotify' : 'SoundCloud'}.{' '}
          <a href={artworkSourceLink.url} target="_blank" rel="noreferrer">
            Open in {release.artwork.source === 'spotify' ? 'Spotify' : 'SoundCloud'}
          </a>
          .
        </p>
      )
    }
  </div>
</article>

<style>
  .release-card {
    --accent: var(--release-accent);
    display: grid;
    min-height: 0;
    grid-template-columns: minmax(280px, 0.9fr) minmax(390px, 1.1fr);
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--release-accent), transparent 60%);
    background:
      radial-gradient(
        circle at 100% 0%,
        color-mix(in srgb, var(--release-accent), transparent 84%),
        transparent 45%
      ),
      var(--release-bg);
    color: var(--release-fg);
    box-shadow: 0 0 50px color-mix(in srgb, var(--release-glow), transparent 92%);
  }

  .release-card__artwork-shell {
    position: relative;
    display: grid;
    min-width: 0;
    min-height: 0;
    border-right: 1px solid color-mix(in srgb, var(--release-accent), transparent 66%);
    background: var(--release-surface);
    place-items: center;
  }

  .release-card__artwork-shell a {
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
  }

  .release-card__artwork {
    width: 100%;
    height: 100%;
    max-height: 100%;
    aspect-ratio: 1;
    object-fit: contain;
  }

  .release-card__focus-label {
    display: none;
  }

  .release-card__copy {
    display: flex;
    min-width: 0;
    padding: clamp(23px, 4.1vh, 54px) clamp(28px, 4.2vw, 66px);
    flex-direction: column;
    justify-content: center;
  }

  .release-card__register {
    display: flex;
    justify-content: space-between;
    color: color-mix(in srgb, var(--release-fg), transparent 48%);
    font-size: 10px;
    letter-spacing: 0.11em;
  }

  .release-card__status,
  .release-card__artist,
  .release-card__metrics strong {
    color: var(--release-accent);
  }

  .release-card__status {
    text-shadow: 0 0 9px var(--release-glow);
  }

  .release-card__artist {
    margin: clamp(17px, 2.4vh, 30px) 0 3px;
    font-size: 12px;
    letter-spacing: 0.12em;
  }

  .release-card__version {
    margin: -8px 0 12px;
    color: color-mix(in srgb, var(--release-accent), var(--release-fg) 34%);
    font-size: 9px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .release-card__meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0 0 clamp(13px, 1.8vh, 22px);
    border-top: 1px solid color-mix(in srgb, var(--release-accent), transparent 72%);
    border-bottom: 1px solid color-mix(in srgb, var(--release-accent), transparent 72%);
  }

  .release-card__genres {
    display: flex;
    padding: 0;
    margin: 0 0 10px;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
  }

  .release-card__genres li {
    padding: 5px 8px;
    border: 1px solid color-mix(in srgb, var(--release-accent), transparent 65%);
    background: color-mix(in srgb, var(--release-accent), transparent 91%);
    color: color-mix(in srgb, var(--release-accent), var(--release-fg) 22%);
    font-size: 8px;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .release-card__meta div {
    padding: 11px 12px 11px 0;
  }

  .release-card__meta dt {
    color: color-mix(in srgb, var(--release-fg), transparent 48%);
    font-size: 9px;
  }

  .release-card__meta dd {
    margin: 2px 0 0;
    font-size: 11px;
  }

  .release-card__biography {
    max-width: 680px;
    margin-bottom: 0;
    color: color-mix(in srgb, var(--release-fg), transparent 22%);
    font-size: clamp(11px, 1.35vh, 14px);
    line-height: 1.55;
  }

  .release-card__metrics,
  .release-card__links {
    padding: 0;
    margin: clamp(10px, 1.8vh, 18px) 0 0;
    gap: 10px;
    list-style: none;
  }

  .release-card__metrics {
    display: grid;
    width: 100%;
    grid-template-columns: repeat(auto-fit, minmax(148px, 1fr));
  }

  .release-card__links {
    display: flex;
    flex-wrap: wrap;
  }

  .release-card__metrics li {
    position: relative;
    display: grid;
    min-width: 0;
    padding: 10px 13px;
    border: 1px solid color-mix(in srgb, var(--release-accent), transparent 70%);
    gap: 2px;
    isolation: isolate;
  }

  .release-card__metrics li[hidden] {
    display: none;
  }

  .release-card__metrics span,
  .release-card__metrics small {
    overflow: hidden;
    color: color-mix(in srgb, var(--release-fg), transparent 50%);
    font-size: 8px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .release-card__metrics strong {
    overflow: hidden;
    font-family: var(--display);
    font-size: 25px;
    text-overflow: ellipsis;
  }

  .release-card__metrics [data-total-metric] {
    border-color: color-mix(in srgb, var(--release-accent), transparent 42%);
    background: color-mix(in srgb, var(--release-accent), transparent 91%);
  }

  .release-card__links :global(.button-link)::before {
    color: var(--release-accent);
  }

  .release-card__pending {
    padding: 10px 14px;
    border: 1px dashed color-mix(in srgb, var(--release-fg), transparent 72%);
    color: color-mix(in srgb, var(--release-fg), transparent 45%);
    font-size: 10px;
  }

  .release-card__attribution {
    margin: clamp(9px, 1.4vh, 15px) 0 0;
    color: color-mix(in srgb, var(--release-fg), transparent 52%);
    font-size: 9px;
  }

  :global(.release-slide) .release-card__artwork-shell,
  :global(.release-slide) .release-card__copy > * {
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 300ms ease,
      transform 420ms cubic-bezier(0.2, 0.72, 0.22, 1),
      filter 300ms ease;
  }

  :global(.release-slide[data-gallery-visible='true']) .release-card__artwork-shell,
  :global(.release-slide[data-gallery-visible='true']) .release-card__copy > * {
    opacity: var(--gallery-content-opacity, 1);
    transform: translateY(var(--gallery-content-shift, 0));
  }

  :global(.release-slide[data-gallery-visible='true']) .release-card__copy > :nth-child(1) {
    transition-delay: 40ms;
  }

  :global(.release-slide[data-gallery-visible='true']) .release-card__copy > :nth-child(2) {
    transition-delay: 80ms;
  }

  :global(.release-slide[data-gallery-visible='true']) .release-card__copy > :nth-child(3) {
    transition-delay: 120ms;
  }

  :global(.release-slide[data-gallery-visible='true']) .release-card__copy > :nth-child(4) {
    transition-delay: 160ms;
  }

  :global(.release-slide[data-gallery-visible='true']) .release-card__copy > :nth-child(n + 5) {
    transition-delay: 200ms;
  }

  @media (max-width: 880px) {
    .release-card {
      display: block;
      height: 100%;
      overflow-x: hidden;
      overflow-y: auto;
      grid-template-columns: 1fr;
      overscroll-behavior: contain;
      scrollbar-width: none;
      scroll-snap-type: y mandatory;
      touch-action: pan-y pinch-zoom;
    }

    .release-card::-webkit-scrollbar {
      display: none;
    }

    .release-card__artwork-shell,
    .release-card__copy {
      width: 100%;
      height: 100%;
      min-height: 100%;
      scroll-snap-align: start;
      scroll-snap-stop: always;
    }

    .release-card__artwork-shell {
      padding: clamp(48px, 8svh, 76px) clamp(18px, 6vw, 32px) clamp(26px, 5svh, 44px);
      border-right: 0;
      border-bottom: 1px solid color-mix(in srgb, var(--release-accent), transparent 66%);
      opacity: var(--release-art-opacity, 1);
    }

    .release-card__artwork-shell a {
      height: min(100%, calc(100svw - 36px));
    }

    .release-card__artwork {
      width: min(100%, 72svh);
      height: min(100%, 72svh);
      object-fit: contain;
    }

    .release-card__focus-label {
      position: absolute;
      z-index: 2;
      top: 14px;
      right: 16px;
      left: 16px;
      display: flex;
      justify-content: space-between;
      color: var(--release-accent);
      font-size: 8px;
      letter-spacing: 0.07em;
    }

    .release-card__copy {
      position: relative;
      overflow: hidden;
      justify-content: center;
      opacity: var(--release-info-opacity, 1);
    }

    .release-card__copy .release-card__focus-label {
      top: 12px;
    }
  }

  @media (max-width: 540px) {
    .release-card__copy {
      padding: 34px 18px 18px;
    }

    .release-card__artist {
      margin-top: 8px;
    }

    .release-card__meta {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin-bottom: 9px;
    }

    .release-card__meta div {
      padding: 7px 8px 7px 0;
    }

    .release-card__genres {
      margin-bottom: 7px;
      gap: 4px;
    }

    .release-card__genres li {
      padding: 3px 6px;
      font-size: 7px;
    }

    .release-card__biography {
      font-size: 10px;
      line-height: 1.42;
    }

    .release-card__metrics {
      grid-template-columns: repeat(auto-fit, minmax(92px, 1fr));
      margin-top: 8px;
      gap: 5px;
    }

    .release-card__metrics li {
      min-height: 50px;
      padding: 6px 7px;
    }

    .release-card__metrics strong {
      font-size: 18px;
    }

    .release-card__metrics span,
    .release-card__metrics small {
      font-size: 6.5px;
    }

    .release-card__links {
      margin-top: 8px;
      gap: 5px;
    }

    .release-card__links :global(.button-link) {
      min-height: 32px;
      padding: 5px 8px;
      font-size: 8px;
    }

    .release-card__attribution {
      display: none;
    }
  }
</style>

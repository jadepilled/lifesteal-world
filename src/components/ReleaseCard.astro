---
import type { GeneratedRelease } from '../lib/schema';
import { releaseArtists } from '../lib/content';
import { withBase } from '../lib/base';
import AsciiTitle from './AsciiTitle.astro';

interface Props {
  release: GeneratedRelease;
  index: number;
}

const { release, index } = Astro.props;
const creditedArtists = releaseArtists(release.artistIds);
const spotifyLink = release.links.find((link) => link.platform === 'spotify');
const artworkSourceLink = release.links.find((link) => link.platform === release.artwork.source);
const artworkDestination = artworkSourceLink?.url ?? spotifyLink?.url ?? release.links[0]?.url;
const artworkPlatform =
  artworkSourceLink?.platform ?? spotifyLink?.platform ?? release.links[0]?.platform;
const artworkSrc = withBase(release.artwork.src);
const responsiveArtwork =
  release.artwork.src.startsWith('/assets/releases/') && release.artwork.src.endsWith('.webp')
    ? `${withBase(release.artwork.src.replace('.webp', '-540.webp'))} 540w, ${withBase(release.artwork.src.replace('.webp', '-800.webp'))} 800w, ${artworkSrc} 1080w`
    : undefined;
const dateLabel = release.releaseDate
  ? new Intl.DateTimeFormat('en-AU', { day: '2-digit', month: 'short', year: 'numeric' })
      .format(new Date(`${release.releaseDate}T00:00:00`))
      .toUpperCase()
  : 'DATE TBA';
const paletteStyle = [
  `--release-bg:${release.palette.background}`,
  `--release-surface:${release.palette.surface}`,
  `--release-fg:${release.palette.foreground}`,
  `--release-accent:${release.palette.accent}`,
  `--release-glow:${release.palette.glow}`,
].join(';');
---

<article class="release-card" style={paletteStyle} data-release-id={release.canonicalId}>
  <div class="release-card__artwork-shell">
    {
      artworkDestination ? (
        <a
          href={artworkDestination}
          target="_blank"
          rel="noreferrer"
          aria-label={`Open ${release.title} on ${artworkPlatform ?? 'its release platform'}`}
        >
          <img
            class="release-card__artwork"
            src={artworkSrc}
            srcset={responsiveArtwork}
            sizes="(max-width: 760px) calc(100vw - 32px), 50vw"
            alt={release.artwork.alt}
            width="1080"
            height="1080"
            loading={index === 0 ? 'eager' : 'lazy'}
            fetchpriority={index === 0 ? 'high' : 'auto'}
          />
        </a>
      ) : (
        <img
          class="release-card__artwork"
          src={artworkSrc}
          srcset={responsiveArtwork}
          sizes="(max-width: 760px) calc(100vw - 32px), 50vw"
          alt={release.artwork.alt}
          width="1080"
          height="1080"
          loading={index === 0 ? 'eager' : 'lazy'}
          fetchpriority={index === 0 ? 'high' : 'auto'}
        />
      )
    }
  </div>

  <div class="release-card__copy">
    <div class="release-card__register">
      <span>REL/{String(index + 1).padStart(3, '0')}</span>
      <span class="release-card__status">[{release.status.toUpperCase()}]</span>
    </div>
    <p class="release-card__artist">
      {creditedArtists.map((artist) => artist.displayName).join(' + ')}
    </p>
    <AsciiTitle text={release.title} accent="var(--release-accent)" />
    {release.version && <p class="release-card__version">{release.version}</p>}
    <dl class="release-card__meta">
      <div>
        <dt>FORMAT</dt>
        <dd>{release.releaseType.toUpperCase()}</dd>
      </div>
      <div>
        <dt>DATE</dt>
        <dd>{dateLabel}</dd>
      </div>
      <div>
        <dt>PRIMARY</dt>
        <dd>{release.artwork.source.toUpperCase()}</dd>
      </div>
    </dl>
    <p class="release-card__biography">{release.biography}</p>

    <ul
      class="release-card__metrics"
      aria-label="Platform metrics"
      data-release-metrics
      hidden={release.metrics.length === 0}
    >
      {
        release.metrics.map((metric) => (
          <li data-platform-metric data-platform={metric.platform} data-kind={metric.kind}>
            <span data-metric-label>{metric.platform.toUpperCase()} PLAYS</span>
            <strong data-metric-value>{new Intl.NumberFormat('en-AU').format(metric.value)}</strong>
            <small data-metric-date>
              AS OF {new Date(metric.asOf).toLocaleDateString('en-AU')}
            </small>
          </li>
        ))
      }
    </ul>

    <ul class="release-card__links" aria-label={`${release.title} platform links`}>
      {
        release.links.map((link) => (
          <li>
            <a class="button-link" href={link.url} target="_blank" rel="noreferrer">
              {link.platform}
            </a>
          </li>
        ))
      }
      {release.links.length === 0 && <li class="release-card__pending">PLATFORM LINKS PENDING</li>}
    </ul>

    {
      ['spotify', 'soundcloud'].includes(release.artwork.source) && artworkSourceLink && (
        <p class="release-card__attribution">
          Artwork and metadata supplied by{' '}
          {release.artwork.source === 'spotify' ? 'Spotify' : 'SoundCloud'}.{' '}
          <a href={artworkSourceLink.url} target="_blank" rel="noreferrer">
            Open in {release.artwork.source === 'spotify' ? 'Spotify' : 'SoundCloud'}
          </a>
          .
        </p>
      )
    }
  </div>
</article>

<style>
  .release-card {
    display: grid;
    min-height: 0;
    grid-template-columns: minmax(280px, 0.9fr) minmax(390px, 1.1fr);
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--release-accent), transparent 60%);
    background:
      radial-gradient(
        circle at 100% 0%,
        color-mix(in srgb, var(--release-accent), transparent 84%),
        transparent 45%
      ),
      var(--release-bg);
    color: var(--release-fg);
    box-shadow: 0 0 50px color-mix(in srgb, var(--release-glow), transparent 92%);
  }

  .release-card__artwork-shell {
    display: grid;
    min-width: 0;
    min-height: 0;
    border-right: 1px solid color-mix(in srgb, var(--release-accent), transparent 66%);
    background: var(--release-surface);
    place-items: center;
  }

  .release-card__artwork-shell a {
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
  }

  .release-card__artwork {
    width: 100%;
    height: 100%;
    max-height: 100%;
    aspect-ratio: 1;
    object-fit: contain;
  }

  .release-card__copy {
    display: flex;
    min-width: 0;
    padding: clamp(23px, 4.1vh, 54px) clamp(28px, 4.2vw, 66px);
    flex-direction: column;
    justify-content: center;
  }

  .release-card__register {
    display: flex;
    justify-content: space-between;
    color: color-mix(in srgb, var(--release-fg), transparent 48%);
    font-size: 10px;
    letter-spacing: 0.11em;
  }

  .release-card__status {
    color: var(--release-accent);
    text-shadow: 0 0 9px var(--release-glow);
  }

  .release-card__artist {
    margin: clamp(17px, 2.4vh, 30px) 0 3px;
    color: var(--release-accent);
    font-size: 12px;
    letter-spacing: 0.12em;
  }

  .release-card__version {
    margin: -8px 0 12px;
    color: color-mix(in srgb, var(--release-accent), var(--release-fg) 34%);
    font-size: 9px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .release-card__meta {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 0 0 clamp(13px, 1.8vh, 22px);
    border-top: 1px solid color-mix(in srgb, var(--release-accent), transparent 72%);
    border-bottom: 1px solid color-mix(in srgb, var(--release-accent), transparent 72%);
  }

  .release-card__meta div {
    padding: 11px 12px 11px 0;
  }

  .release-card__meta dt {
    color: color-mix(in srgb, var(--release-fg), transparent 48%);
    font-size: 9px;
  }

  .release-card__meta dd {
    margin: 2px 0 0;
    font-size: 11px;
  }

  .release-card__biography {
    max-width: 680px;
    margin-bottom: 0;
    color: color-mix(in srgb, var(--release-fg), transparent 22%);
    font-size: clamp(11px, 1.35vh, 14px);
    line-height: 1.55;
  }

  .release-card__metrics,
  .release-card__links {
    display: flex;
    padding: 0;
    margin: clamp(10px, 1.8vh, 18px) 0 0;
    flex-wrap: wrap;
    gap: 10px;
    list-style: none;
  }

  .release-card__metrics li {
    display: grid;
    padding: 10px 13px;
    border: 1px solid color-mix(in srgb, var(--release-accent), transparent 70%);
    gap: 2px;
  }

  .release-card__metrics span,
  .release-card__metrics small {
    color: color-mix(in srgb, var(--release-fg), transparent 50%);
    font-size: 8px;
  }

  .release-card__metrics strong {
    color: var(--release-accent);
    font-family: var(--display);
    font-size: 25px;
  }

  .release-card__links :global(.button-link)::before {
    color: var(--release-accent);
  }

  .release-card__pending {
    padding: 10px 14px;
    border: 1px dashed color-mix(in srgb, var(--release-fg), transparent 72%);
    color: color-mix(in srgb, var(--release-fg), transparent 45%);
    font-size: 10px;
  }

  .release-card__attribution {
    margin: clamp(9px, 1.4vh, 15px) 0 0;
    color: color-mix(in srgb, var(--release-fg), transparent 52%);
    font-size: 9px;
  }

  @media (max-width: 880px) {
    .release-card {
      grid-template-columns: 1fr;
    }

    .release-card__artwork-shell {
      min-height: auto;
      border-right: 0;
      border-bottom: 1px solid color-mix(in srgb, var(--release-accent), transparent 66%);
    }

    .release-card__artwork {
      height: auto;
    }
  }

  @media (max-width: 540px) {
    .release-card__copy {
      padding: 30px 22px 38px;
    }

    .release-card__artist {
      margin-top: 30px;
    }

    .release-card__meta {
      grid-template-columns: 1fr;
    }

    .release-card__meta div:not(:last-child) {
      border-bottom: 1px dotted color-mix(in srgb, var(--release-accent), transparent 75%);
    }
  }
</style>

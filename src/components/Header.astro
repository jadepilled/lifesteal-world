---
import { withBase } from '../lib/base';
import figlet from 'figlet';

const pathname = Astro.url.pathname;
const navigation = [
  { href: '/artists/', label: 'artists' },
  { href: '/releases/', label: 'releases' },
  { href: '/radio/', label: 'radio' },
  { href: '/store/', label: 'store' },
  { href: '/about/', label: 'about' },
];
const asciiMark = figlet
  .textSync('lifesteal', {
    font: 'Small',
    horizontalLayout: 'fitted',
    verticalLayout: 'fitted',
  })
  .trimEnd();
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="wordmark prism-hover" href={withBase('/')} aria-label="lifesteal home">
      <pre class="wordmark__base" aria-hidden="true">{asciiMark}</pre>
      <pre class="wordmark__prism" aria-hidden="true">{asciiMark}</pre>
    </a>

    <nav class="site-nav" aria-label="Primary navigation">
      <span class="site-nav__prompt" aria-hidden="true">&gt;</span>
      <ul>
        {
          navigation.map((item) => (
            <li>
              <a
                class="prism-hover"
                href={withBase(item.href)}
                aria-current={pathname.startsWith(withBase(item.href)) ? 'page' : undefined}
              >
                <span class="site-nav__label">{item.label}</span>
                <span class="site-nav__prism" aria-hidden="true">
                  {item.label}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const runPrism = (element: HTMLElement) => {
    element.classList.remove('prism-hover--run');
    void element.offsetWidth;
    element.classList.add('prism-hover--run');
  };

  const bindPrisms = () => {
    document.querySelectorAll<HTMLElement>('.site-header .prism-hover').forEach((element) => {
      if (element.dataset.prismBound === 'true') return;
      element.dataset.prismBound = 'true';
      element.addEventListener('pointerenter', () => runPrism(element));
      element.addEventListener('focus', () => runPrism(element));
      element.addEventListener('animationend', (event) => {
        if ((event as AnimationEvent).animationName === 'header-prism') {
          element.classList.remove('prism-hover--run');
        }
      });
    });
  };

  const updateCurrentPage = () => {
    const current = new URL(window.location.href).pathname;
    document.querySelectorAll<HTMLAnchorElement>('.site-nav a').forEach((link) => {
      const path = new URL(link.href).pathname;
      link.toggleAttribute('aria-current', current.startsWith(path));
      if (link.hasAttribute('aria-current')) link.setAttribute('aria-current', 'page');
    });
    bindPrisms();
  };

  document.addEventListener('astro:page-load', updateCurrentPage);
</script>
